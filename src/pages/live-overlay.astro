        align-items: center;
        padding: 0 34px;
        background: linear-gradient(100deg, #05662e, #003819 70%, #012713);
        box-shadow: 0 10px 32px rgb(0 0 0 / 38%);
        font-size: 29px;
        font-weight: 700;
        letter-spacing: .04em;
        opacity: 0;
        transform: translateY(-16px);
        transition: opacity 500ms ease 500ms, transform 500ms ease 500ms;
      }

      .summary-heading strong { font-size: 38px; font-weight: 700; }

      .summary-chart {
        min-width: 0;
        align-self: stretch;
        opacity: 0;
        transform: translateY(25px) scale(.98);
        transition: opacity 500ms ease, transform 500ms ease;
      }

      .summary-chart svg { display: block; width: 100%; height: 100%; overflow: visible; }
      .summary-grid { opacity: 0; transition: opacity 1000ms ease; }
      .summary-grid line { stroke: rgb(255 255 255 / 46%); stroke-width: 1.5; }
      .summary-grid text { fill: rgb(255 255 255 / 86%); font-size: 20px; font-weight: 700; }
      .summary-x-label { text-anchor: middle; }
      .summary-y-label { dominant-baseline: middle; text-anchor: start; }
      .summary-line { fill: none; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 2000; stroke-dashoffset: 2000; filter: drop-shadow(0 0 5px rgb(255 255 255 / 26%)); }

      .summary-cards {
        display: grid;
        grid-template-rows: repeat(4, 1fr);
        gap: 0;
        min-height: 0;
        padding-top: 60px;
        box-sizing: border-box;
      }

      .summary-card {
        position: relative;
        display: grid;
        gap: 6px;
        padding: 14px 20px;
        overflow: hidden;
        background: var(--team-color);
        background: linear-gradient(105deg, rgb(var(--team-rgb) / 96%), rgb(var(--team-rgb) / 64%));
        border-left: 8px solid var(--team-color);
        box-shadow: 0 8px 24px rgb(0 0 0 / 35%);
        opacity: 0;
        transform: translateX(38px);
        transition: opacity 400ms ease, transform 400ms ease;
      }

      .summary-card::after { position: absolute; inset: 0; content: ""; background: linear-gradient(130deg, transparent 55%, rgb(255 255 255 / 12%)); pointer-events: none; }
      .summary-card strong { position: absolute; top: 50%; left: 20px; overflow: hidden; max-width: calc(100% - 40px); font-size: 60px; line-height: 1; text-overflow: ellipsis; transform: translateY(-50%); white-space: nowrap; }
      .summary-card small { position: absolute; top: calc(50% + 46px); left: 20px; font-size: 32px; font-weight: 700; line-height: 1; opacity: .9; }

      .summary-table {
        position: absolute;
        top: 176px;
        right: 72px;
        bottom: 58px;
        left: 510px;
        display: grid;
        place-items: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 1000ms ease;
      }

      .summary-table table { width: 100%; height: 100%; table-layout: fixed; border-collapse: collapse; background: rgb(0 0 0 / 40%); box-shadow: 0 14px 40px rgb(0 0 0 / 35%); font-family: "Microsoft YaHei", "Noto Sans CJK SC", sans-serif; font-size: 54px; font-synthesis: none; }
      .summary-table th, .summary-table td { padding: 10px; border-bottom: 1px solid rgb(255 255 255 / 26%); text-align: center; white-space: nowrap; }
      .summary-table th { font-size: 34px; font-weight: 700; }
      .summary-table thead { background: rgb(0 102 46 / 88%); }
      .summary-table thead { height: 60px; }
      .summary-table tbody { height: calc(100% - 60px); }
      .summary-table tbody tr { height: 25%; }
      .summary-table thead th { letter-spacing: -.08em; }
      .summary-number { font-variant-numeric: tabular-nums; font-weight: 800; }
      .summary-unit { margin-left: 3px; font-size: 34px; font-weight: 400; }
      .summary-score { display: block; }
      .summary-pt { display: block; margin-top: 8px; font-size: 34px; font-weight: 400; line-height: 1; }

      .summary-axes .summary-heading { opacity: 1; transform: none; }
      .summary-axes .summary-chart { opacity: 1; transform: translateY(25px); }
      .summary-axes .summary-grid { opacity: 1; }
      .summary-lines .summary-line { animation: summary-line-reveal 2000ms ease-in-out forwards; }
      .summary-cards-in .summary-card { opacity: 1; transform: none; }
      .summary-cards-in .summary-card:nth-child(2) { transition-delay: 180ms; }
      .summary-cards-in .summary-card:nth-child(3) { transition-delay: 360ms; }
      .summary-cards-in .summary-card:nth-child(4) { transition-delay: 540ms; }
      .summary-table-stage .summary-chart { opacity: 0; transform: translate(-30px, 25px); }
      .summary-table-stage .summary-cards { transition: transform 1000ms ease; transform: translateX(calc(-100vw + 570px)); }
      .summary-table-in .summary-table { opacity: 1; }

      @keyframes summary-line-reveal { to { stroke-dashoffset: 0; } }

      .summary-active .event-bug,
      .summary-active::before,
      .summary-active .score-bug,
      .summary-active .dora-bug,
      .summary-active .score-board { opacity: 0; transition: opacity 350ms ease; }

      .is-empty .event-bug,
      .is-empty::before,
      .is-empty .score-bug,
      .is-empty .dora-bug,
      .is-empty .score-board {
        display: none;
      }

      @media (max-width: 1280px) {
        .event-bug {
          top: 24px;
          right: 34px;
          transform: scale(.82);
          transform-origin: top right;
        }

        .score-bug {
          top: 24px;
          left: 32px;
          transform: scale(.82);
          transform-origin: top left;
        }

        .dora-bug {
          top: 24px;
          left: 282px;
          transform: scale(.84);
          transform-origin: top left;
        }

        .score-board {
          right: 54px;
          bottom: 28px;
          left: 54px;
          gap: 18px;
        }

        .player-lower {
          grid-template-columns: 58px minmax(0, 1fr);
          height: 124px;
        }

        .portrait-chip {
          width: 54px;
          height: 84px;
          transform: translateY(-26px);
        }

        .portrait-chip span {
          width: 46px;
          height: 46px;
          font-size: 28px;
        }

        .portrait-chip small {
          width: 76px;
          font-size: 16px;
        }

        .info-pack {
          padding-left: 3px;
        }

        .player {
          font-size: 24px;
        }

        .change-delta {
          bottom: 54px;
          font-size: 30px;
        }

        .score-plate {
          height: 48px;
          padding-right: 13px;
        }

        .score {
          font-size: 38px;
        }

        .player-lower.dealer::after {
          left: 0;
        }

        .waits {
          top: 0;
          right: 0;
          left: auto;
          width: 100%;
          height: 46px;
        }

        .pool-change {
          height: 46px;
          font-size: 24px;
          line-height: 46px;
        }
      }

      @media (max-width: 900px) {
        .score-board {
          right: 30px;
          left: 30px;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          row-gap: 16px;
        }
      }
    </style>
  </body>
