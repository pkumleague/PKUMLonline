---
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>直播叠加源 | PKU M.LEAGUE</title>
  </head>
  <body>
    <div id="overlay" class="overlay">
      <section class="event-bug">
        <div class="event-bug-card">
          <div class="event-bug-face event-bug-front">
            <div class="event-text">
              <strong id="season-label">常规赛</strong>
              <span id="match-label">Sep.11 #001</span>
            </div>
            <img class="event-logo" src={`${base}PLG标志平面.png`} alt="" />
          </div>
          <div class="event-bug-face event-bug-back" aria-hidden="true">
            <img class="event-logo-word" src={`${base}浪速字无底.png`} alt="" />
            <img class="event-logo-naniwa" src={`${base}浪速无底.png`} alt="" />
          </div>
        </div>
      </section>

      <section class="score-bug">
        <div id="round-label" class="round-chip">东 1 局</div>
        <div class="stick-stack">
          <div class="stick-line">
            <span class="stick riichi-dot"></span>
            <strong id="pool-label">0</strong>
          </div>
          <div class="stick-line">
            <span class="stick honba-dot"></span>
            <strong id="honba-label">0</strong>
          </div>
        </div>
      </section>

      <section class="dora-bug">
        <div id="dora-tiles" class="tile-row"></div>
      </section>

      <section id="score-board" class="score-board"></section>
      <div id="connection-warning" class="connection-warning" role="status">直播数据连接中断</div>
      <section id="summary-scene" class="summary-scene" aria-hidden="true">
        <header id="summary-heading" class="summary-heading"></header>
        <div id="summary-chart" class="summary-chart"></div>
        <aside id="summary-cards" class="summary-cards"></aside>
        <div id="summary-table" class="summary-table"></div>
      </section>
    </div>

    <script>
      import teamsRaw from '../../data/teams.json'
      import { dealerSeat, seatWindFromDealer } from '../lib/scoring'
      import { replayGame } from '../lib/replay'
      import { rawScoreOf, rankPointsForScores } from '../lib/aggregate'
      import { liveStorageKey, tileImageSrc, tileLabel } from '../lib/live'

      const params = new URLSearchParams(location.search)
      const gameId = params.get('id') ?? 'default'
      const sourceId = params.get('source')
      const key = liveStorageKey(gameId)
      const apiBase = import.meta.env.BASE_URL
      const teams = new Map((teamsRaw.teams ?? []).map((team) => [team.name, team.color]))
      const overlay = document.getElementById('overlay')
      const matchLabel = document.getElementById('match-label')
      const seasonLabel = document.getElementById('season-label')
      const roundLabelEl = document.getElementById('round-label')
      const honbaLabel = document.getElementById('honba-label')
      const poolLabel = document.getElementById('pool-label')
      const doraTiles = document.getElementById('dora-tiles')
      const board = document.getElementById('score-board')
      const connectionWarning = document.getElementById('connection-warning')
      const summaryScene = document.getElementById('summary-scene')
      const summaryHeading = document.getElementById('summary-heading')
      const summaryChart = document.getElementById('summary-chart')
      const summaryCards = document.getElementById('summary-cards')
      const summaryTable = document.getElementById('summary-table')
      const scoreBug = document.querySelector('.score-bug')
      const doraBug = document.querySelector('.dora-bug')

      let lastText = ''
      let remoteState = null
      let remoteRevision = 0
      let displayedScores = null
      let previousSettled = 0
      let animationTimer = 0
      let topTransitionTimer = 0
      let topWipeTimer = 0
      let topTransitionRun = 0
      let topInitialized = false
      let displayedTopKey = ''
      let displayedDealer = null
      let displayedSummaryId = ''
      let summaryTimers = []
      let scoreAnimationRun = 0
      let scoreAnimationTimers = []
      let animationTargetScores = null
      let lastRemoteSuccessAt = Date.now()
      let lastAckAt = 0
      let ackInFlight = false
      let readyAckRevision = 0
      let ackReadyTimer = 0
      const playerCardKeys = []
      const TOP_LEFT_BG_FULL_WIDTH = 506
      const DORA_BG_STEP = 48

      function readState() {
        if (remoteState) return remoteState
        try {
          const raw = localStorage.getItem(key)
          return raw ? JSON.parse(raw) : null
        } catch {
          return null
        }
      }

      async function refreshRemoteState() {
        const controller = new AbortController()
        const timeout = window.setTimeout(() => controller.abort(), 4000)
        try {
          const res = await fetch(`${apiBase}api/games/${encodeURIComponent(gameId)}/live-state`, {
            cache: 'no-store',
            signal: controller.signal,
          })
          if (!res.ok) throw new Error(`HTTP ${res.status}`)
          const body = await res.json()
          const incomingRevision = Number(body?.revision ?? 0)
          lastRemoteSuccessAt = Date.now()
          connectionWarning?.classList.remove('visible')
          if (!body?.data) {
            remoteState = null
            remoteRevision = 0
            overlay?.classList.add('is-empty')
            return
          }
          if (incomingRevision > remoteRevision) {
            remoteState = body.data
            remoteRevision = incomingRevision
            render()
            scheduleRevisionAcknowledgement(incomingRevision)
          }
          void acknowledgeRevision(readyAckRevision)
        } catch {
          if (Date.now() - lastRemoteSuccessAt > 5000) connectionWarning?.classList.add('visible')
        } finally {
          window.clearTimeout(timeout)
        }
      }

      async function acknowledgeRevision(revision) {
        if (!sourceId || revision < 1 || ackInFlight) return
        const now = Date.now()
        if (now - lastAckAt < 3000) return
        ackInFlight = true
        try {
          const res = await fetch(`${apiBase}api/games/${encodeURIComponent(gameId)}/live-ack`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sourceId, revision }),
          })
          if (res.ok) lastAckAt = now
        } catch {
          // The read loop remains authoritative and retries the heartbeat later.
        } finally {
          ackInFlight = false
        }
      }

      function scheduleRevisionAcknowledgement(revision) {
        readyAckRevision = 0
        window.clearTimeout(ackReadyTimer)
        ackReadyTimer = window.setTimeout(() => {
          readyAckRevision = revision
          void acknowledgeRevision(revision)
        }, 3600)
      }

      async function pollRemoteState() {
        await refreshRemoteState()
        window.setTimeout(pollRemoteState, 500)
      }

      function render() {
        const state = readState()
        if (!state) {
          overlay?.classList.add('is-empty')
          return
        }
        overlay?.classList.remove('is-empty')

        const rep = replayGame(state.rounds ?? [])
        maybePlaySummary(state, rep)
        const current = rep.current
        const scores = Array.isArray(state.scoreOverride) ? state.scoreOverride : current.scores
        const seats = state.game?.seats ?? []
        const game = state.game ?? {}
        const currentOrder = current.settled + 1
        const dealer = dealerSeat(current.round)
        const nextText = JSON.stringify({
          scores: scores.map(Number),
          seats: seats.map(playerCardKey),
          dealer,
          round: current.round,
          waits: state.currentWaits,
          dora: state.currentDora,
          currentOrder,
        })
        if (nextText === lastText) return
        lastText = nextText
        if (animationTargetScores) cancelScoreAnimation(true)
        cancelTopTransition()
        const prevScores = displayedScores
        const scoreChanged = Array.isArray(prevScores) && scores.some((score, i) => Number(score) !== Number(prevScores[i]))
        const deltas = scoreChanged ? scores.map((score, i) => Number(score) - Number(prevScores[i] ?? score)) : [0, 0, 0, 0]
        const settledAdvanced = current.settled > previousSettled
        const topChanged = topInitialized && topInfoKey(current) !== displayedTopKey
        const scoreParts = scoreChanged && settledAdvanced ? splitScoreChanges(rep, deltas) : {
          nameDeltas: deltas,
          poolEntries: [[], [], [], []],
        }
        const isNextRound = topChanged
        const renderDealer = scoreChanged && settledAdvanced && isNextRound && displayedDealer != null
          ? displayedDealer
          : dealer

        if (!isNextRound) updateTopInfo(game, current, state.currentDora ?? [])

        const renderScores = scoreChanged ? prevScores : scores
        syncScoreBoard(seats, scores, renderScores, renderDealer, state.currentWaits ?? [], scoreChanged)
        displayedDealer = renderDealer
        previousSettled = current.settled
        if (scoreChanged) {
          playScoreChange(scores, scoreParts.nameDeltas, scoreParts.poolEntries)
          if (isNextRound) clearDoraForNextRound()
        } else {
          displayedScores = scores.map(Number)
        }
        if (isNextRound) {
          const run = topTransitionRun
          topTransitionTimer = window.setTimeout(() => {
            if (run !== topTransitionRun) return
            updateTopInfo(game, current, state.currentDora ?? [], true, run)
            setDisplayedDealer(dealer)
          }, 2500)
        }
      }

      function cancelTopTransition() {
        topTransitionRun += 1
        window.clearTimeout(topTransitionTimer)
        window.clearTimeout(topWipeTimer)
        overlay?.querySelectorAll('.top-wipe-layer').forEach((layer) => layer.remove())
        scoreBug?.classList.remove('top-hidden')
        doraBug?.classList.remove('top-hidden')
      }

      function playerCardKey(seat, index) {
        const player = seat?.player ?? seat?.name ?? ''
        return JSON.stringify({
          id: seat?.id ?? seat?.playerId ?? null,
          player,
          team: seat?.team ?? '',
          seat: seat?.seat ?? ['东', '南', '西', '北'][index],
          avatar: seat?.avatar ?? seat?.avatarUrl ?? seat?.photo ?? null,
        })
      }

      function createPlayerCard(seat, index, score, dealer) {
        const team = seat?.team ?? ''
        const player = seat?.player ?? seat?.name ?? ''
        const card = document.createElement('article')
        card.className = 'player-lower'
        const teamColor = teams.get(team) ?? '#242a33'
        card.style.setProperty('--team-color', teamColor)
        card.style.setProperty('--team-rgb', hexToRgb(teamColor))

        const waits = document.createElement('div')
        waits.className = 'waits tile-row'
        const poolChange = document.createElement('div')
        poolChange.className = 'pool-change'
        const portrait = document.createElement('div')
        portrait.className = 'portrait-chip'
        const seatLabel = document.createElement('span')
        seatLabel.textContent = traditionalSeat(seatWindFromDealer(index, dealer))
        const teamLabel = document.createElement('small')
        teamLabel.textContent = team
        portrait.append(seatLabel, teamLabel)
        const info = document.createElement('div')
        info.className = 'info-pack'
        const playerLabel = document.createElement('div')
        playerLabel.className = 'player'
        playerLabel.textContent = player
        const delta = document.createElement('div')
        delta.className = 'change-delta'
        const scorePlate = document.createElement('div')
        scorePlate.className = 'score-plate'
        const scoreLabel = document.createElement('span')
        scoreLabel.className = 'score'
        scoreLabel.dataset.score = String(Number(score ?? 25000))
        scoreLabel.textContent = formatScore(score ?? 25000)
        scorePlate.appendChild(scoreLabel)
        info.append(playerLabel, delta, scorePlate)
        card.append(waits, poolChange, portrait, info)
        return card
      }

      function syncScoreBoard(seats, scores, renderScores, dealer, waitsBySeat, scoreChanged) {
        for (let i = 0; i < 4; i++) {
          const seat = seats[i] ?? {}
          const key = playerCardKey(seat, i)
          let card = board.children[i]
          if (!card || playerCardKeys[i] !== key) {
            const replacement = createPlayerCard(seat, i, renderScores[i] ?? 25000, dealer)
            if (card) board.replaceChild(replacement, card)
            else board.appendChild(replacement)
            card = replacement
            playerCardKeys[i] = key
          }
          card.classList.toggle('dealer', i === dealer)
          setCardSeat(card, i, dealer)
          const scoreLabel = card.querySelector('.score')
          if (scoreLabel) {
            scoreLabel.dataset.score = String(Number(scores[i] ?? 25000))
            if (!scoreChanged) scoreLabel.textContent = formatScore(scores[i] ?? 25000)
          }
          renderTiles(card.querySelector('.waits'), waitsBySeat[i] ?? [])
        }
        while (board.children.length > 4) board.lastElementChild?.remove()
        playerCardKeys.length = 4
      }

      function updateTopInfo(game, current, doraCodes, withTransition = false, run = topTransitionRun) {
        const nextRoundKey = topInfoKey(current)
        if (!topInitialized) {
          setTopInfo(game, current, doraCodes, nextRoundKey, false)
          topInitialized = true
          return
        }
        if (!withTransition) {
          renderTiles(doraTiles, doraCodes)
          return
        }
        if (withTransition) {
          wipeTopInfo(game, current, doraCodes, nextRoundKey, run)
          return
        }
      }

      function setDisplayedDealer(dealer) {
        displayedDealer = dealer
        ;[...board.querySelectorAll('.player-lower')].forEach((card, i) => {
          card.classList.toggle('dealer', i === dealer)
          setCardSeat(card, i, dealer)
        })
      }

      function setCardSeat(card, index, dealer) {
        const seat = card.querySelector('.portrait-chip > span')
        if (seat) seat.textContent = traditionalSeat(seatWindFromDealer(index, dealer))
      }

      function maybePlaySummary(state, rep) {
        const id = state.summary?.id
        if (!id || id === displayedSummaryId || rep.history.length === 0) return
        displayedSummaryId = id
        playSummary(state, rep)
      }

      function playSummary(state, rep) {
        if (!summaryScene || !summaryHeading || !summaryChart || !summaryCards || !summaryTable) return
        summaryTimers.forEach((timer) => clearTimeout(timer))
        summaryTimers = []
        const seats = state.game?.seats ?? []
        const scores = rep.current.scores.map(Number)
        const ranks = competitionRanks(scores)
        const gameRound = String(state.game?.round ?? '').match(/\d+/)?.[0] ?? ''
        const drawCount = rep.history.filter((item) => item.result.winType === 'draw').length
        summaryHeading.innerHTML = `<strong>${escapeHtml(state.game?.stage ?? '常规赛')}${gameRound ? ` · 第${gameRound}半庄` : ''}</strong><span>总局数 / ${rep.history.length} 局（流局数 / ${drawCount} 局）</span>`
        summaryChart.innerHTML = buildSummaryChart(rep, seats)
        summaryCards.innerHTML = seats
          .map((seat, i) => ({ seat, i, score: scores[i], rank: ranks[i] }))
          .sort((a, b) => a.rank - b.rank || b.score - a.score)
          .map(({ seat, i }) => {
            const teamColor = teams.get(seat.team ?? '') ?? '#242a33'
            return `<article class="summary-card" style="--team-color:${escapeHtml(teamColor)};--team-rgb:${hexToRgb(teamColor)}"><strong>${escapeHtml(seat.player ?? seat.name ?? seat.team ?? `选手${i + 1}`)}</strong><small>${escapeHtml(seat.team ?? '')}</small></article>`
          })
          .join('')
        summaryTable.innerHTML = buildSummaryTable(rep, seats, scores, ranks)
        overlay?.classList.add('summary-active')
        summaryScene.className = 'summary-scene summary-covering'
        void summaryScene.offsetWidth
        summaryTimers.push(window.setTimeout(() => summaryScene.classList.add('summary-axes'), 1000))
        summaryTimers.push(window.setTimeout(() => summaryScene.classList.add('summary-lines'), 2000))
        summaryTimers.push(window.setTimeout(() => summaryScene.classList.add('summary-cards-in'), 4000))
        summaryTimers.push(window.setTimeout(() => summaryScene.classList.add('summary-table-stage'), 15000))
        summaryTimers.push(window.setTimeout(() => summaryScene.classList.add('summary-table-in'), 16000))
      }

      function buildSummaryChart(rep, seats) {
        const values = rep.history.flatMap((item) => item.scores.map(Number)).concat([25000])
        const low = Math.min(...values)
        const high = Math.max(...values)
        const span = Math.max(1, high - low)
        const width = 960
        const height = 560
        const left = 76
        const right = 26
        const top = 24
        const bottom = 54
        const series = seats.map((seat, i) => {
          const points = [25000, ...rep.history.map((item) => item.scores[i])]
            .map((score, index) => `${left + index * ((width - left - right) / Math.max(1, rep.history.length))},${top + (high - Number(score)) / span * (height - top - bottom)}`)
            .join(' ')
          return `<polyline class="summary-line" style="stroke:${escapeHtml(teams.get(seat.team ?? '') ?? '#fff')}" points="${points}" />`
        }).join('')
        const verticals = Array.from({ length: rep.history.length + 1 }, (_, i) => {
          const x = left + i * ((width - left - right) / Math.max(1, rep.history.length))
          const currentRound = i > 0 ? rep.history[i - 1].round : null
          const previousRound = i > 1 ? rep.history[i - 2].round : null
          const label = !currentRound
            ? ''
            : currentRound.wind !== previousRound?.wind
              ? `${currentRound.wind}${currentRound.number}`
              : String(currentRound.number)
          return `<line x1="${x}" y1="${top}" x2="${x}" y2="${height - bottom}" /><text class="summary-x-label" x="${x}" y="${height - 16}">${label}</text>`
        }).join('')
        return `<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="四位选手分数走势"><g class="summary-grid"><line x1="${left}" y1="${top}" x2="${left}" y2="${height - bottom}" /><line x1="${left}" y1="${height - bottom}" x2="${width - right}" y2="${height - bottom}" />${verticals}<text class="summary-y-label" x="8" y="${top}">${formatScore(high)}</text><text class="summary-y-label" x="8" y="${height - bottom}">${formatScore(low)}</text></g><g>${series}</g></svg>`
      }

      function buildSummaryTable(rep, seats, scores, ranks) {
        const count = (fn) => seats.map((_, i) => fn(i))
        const riichi = count((i) => rep.history.filter((item) => item.result.riichi?.[i]).length)
        const ron = count((i) => rep.history.filter((item) => item.result.winType === 'ron' && item.result.winner === i).length)
        const tsumo = count((i) => rep.history.filter((item) => item.result.winType === 'tsumo' && item.result.winner === i).length)
        const dealIn = count((i) => rep.history.filter((item) => item.result.winType === 'ron' && item.result.loser === i).length)
        const rankPoints = rankPointsForScores(scores)
        const pts = scores.map((score, i) => Math.round((rawScoreOf(score) + rankPoints[i]) * 10) / 10)
        const rows = seats.map((seat, i) => ({
          i,
          rank: ranks[i],
          score: scores[i],
          riichi: riichi[i],
          wins: ron[i] + tsumo[i],
          dealIn: dealIn[i],
        })).sort((a, b) => a.rank - b.rank || b.score - a.score)
        const amount = (value, unit) => `<span class="summary-number">${value}</span><span class="summary-unit">${unit}</span>`
        const ptText = (value) => `${value > 0 ? '+' : ''}${value}`
        return `<table><thead><tr><th>顺位</th><th>最终持有点</th><th>立直次数</th><th>和牌次数</th><th>放铳次数</th></tr></thead><tbody>${rows.map((row) => `<tr><td>${amount(row.rank, '位')}</td><td><span class="summary-number summary-score">${formatScore(row.score)}</span><small class="summary-pt">(${ptText(pts[row.i])})</small></td><td>${amount(row.riichi, '回')}</td><td>${amount(row.wins, '回')}</td><td>${amount(row.dealIn, '回')}</td></tr>`).join('')}</tbody></table>`
      }

      function competitionRanks(scores) {
        const order = scores.map((score, i) => ({ score, i })).sort((a, b) => b.score - a.score)
        const ranks = new Array(scores.length).fill(0)
        let start = 0
        while (start < order.length) {
          let end = start
          while (end + 1 < order.length && order[end + 1].score === order[start].score) end++
          for (let i = start; i <= end; i++) ranks[order[i].i] = start + 1
          start = end + 1
        }
        return ranks
      }

      function clearDoraForNextRound() {
        if (!doraTiles?.classList.contains('has-tiles') || doraTiles.classList.contains('dora-clearing')) return
        updateTopLeftBackground([])
        doraTiles.classList.add('dora-clearing')
        window.setTimeout(() => {
          doraTiles.classList.remove('has-tiles', 'tiles-exiting', 'dora-clearing')
          doraTiles.querySelectorAll('.tile').forEach((tile) => tile.remove())
        }, 500)
      }

      function setTopInfo(game, current, doraCodes, nextRoundKey, clearEmptyDora = false) {
        seasonLabel.textContent = game.stage ? String(game.stage) : '常规赛'
        matchLabel.textContent = `${formatMatchDate(game.date)} #${roundNumber(game.round)}`
        roundLabelEl.innerHTML = roundParts(current.round).map((part) => `<span>${escapeHtml(part)}</span>`).join('')
        honbaLabel.textContent = String(current.round.honba)
        poolLabel.textContent = String(current.pool)
        displayedTopKey = nextRoundKey
        if (clearEmptyDora && doraCodes.length === 0) {
          updateTopLeftBackground([])
          doraTiles.classList.remove('has-tiles', 'tiles-exiting')
          doraTiles.querySelectorAll('.tile').forEach((tile) => tile.remove())
        } else {
          renderTiles(doraTiles, doraCodes)
        }
      }

      function topInfoKey(current) {
        return JSON.stringify({ round: current.round, pool: current.pool })
      }

      function wipeTopInfo(game, current, doraCodes, nextRoundKey, run) {
        const oldLayer = buildTopWipeLayer('old')
        const newLayer = buildTopWipeLayer('new')
        if (!oldLayer || !newLayer) {
          setTopInfo(game, current, doraCodes, nextRoundKey, true)
          return
        }

        setTopInfoToLayer(newLayer, game, current, doraCodes)
        overlay?.append(oldLayer, newLayer)
        scoreBug?.classList.add('top-hidden')
        doraBug?.classList.add('top-hidden')
        oldLayer.classList.add('wipe-old')
        newLayer.classList.add('wipe-new')

        topWipeTimer = window.setTimeout(() => {
          if (run !== topTransitionRun) return
          oldLayer.remove()
          newLayer.remove()
          scoreBug?.classList.remove('top-hidden')
          doraBug?.classList.remove('top-hidden')
          setTopInfo(game, current, doraCodes, nextRoundKey, true)
        }, 1000)
      }

      function buildTopWipeLayer(kind) {
        if (!scoreBug || !doraBug) return null
        const layer = document.createElement('div')
        layer.className = `top-wipe-layer top-wipe-${kind}`
        layer.append(scoreBug.cloneNode(true))
        return layer
      }

      function setTopInfoToLayer(layer, game, current, doraCodes) {
        const season = layer.querySelector('#season-label')
        const match = layer.querySelector('#match-label')
        const round = layer.querySelector('#round-label')
        const honba = layer.querySelector('#honba-label')
        const pool = layer.querySelector('#pool-label')
        if (season) season.textContent = game.stage ? String(game.stage) : '常规赛'
        if (match) match.textContent = `${formatMatchDate(game.date)} #${roundNumber(game.round)}`
        if (round) round.innerHTML = roundParts(current.round).map((part) => `<span>${escapeHtml(part)}</span>`).join('')
        if (honba) honba.textContent = String(current.round.honba)
        if (pool) pool.textContent = String(current.pool)
      }

      function splitScoreChanges(rep, totalDeltas) {
        const latest = rep.history[rep.history.length - 1]
        if (!latest) return { nameDeltas: totalDeltas, poolEntries: [[], [], [], []] }
        const previous = rep.history[rep.history.length - 2]
        const poolBefore = previous ? previous.pool : 0
        const riichi = latest.result.riichi ?? [false, false, false, false]
        const riichiCount = riichi.filter(Boolean).length
        const poolEntries = [[], [], [], []]
        const poolNet = [0, 0, 0, 0]

        if ((latest.result.winType === 'ron' || latest.result.winType === 'tsumo') && latest.result.winner != null) {
          const gain = (poolBefore + riichiCount) * 1000
          if (gain > 0) {
            poolEntries[latest.result.winner].push(gain)
            poolNet[latest.result.winner] += gain
          }
        }

        riichi.forEach((declared, i) => {
          if (!declared) return
          poolEntries[i].push(-1000)
          poolNet[i] -= 1000
        })

        return {
          nameDeltas: totalDeltas.map((delta, i) => delta - poolNet[i]),
          poolEntries,
        }
      }

      function playScoreChange(nextScores, deltas, poolEntries) {
        cancelScoreAnimation(false)
        const run = scoreAnimationRun
        animationTargetScores = nextScores.map(Number)
        const cards = [...board.querySelectorAll('.player-lower')]
        cards.forEach((card, i) => {
          card.classList.add('score-changing')
          const deltaEl = card.querySelector('.change-delta')
          const poolEl = card.querySelector('.pool-change')
          if (deltaEl) {
            deltaEl.textContent = deltas[i] === 0 ? '' : signedScore(deltas[i])
            deltaEl.className = `change-delta ${deltas[i] >= 0 ? 'positive' : 'negative'}`
          }
          if (poolEl) {
            renderPoolEntries(poolEl, poolEntries[i] ?? [])
          }
        })

        animationTimer = scheduleScoreAnimation(run, () => {
          cards.forEach((card) => card.classList.add('show-delta'))
          scheduleScoreAnimation(run, () => {
            cards.forEach((card) => card.classList.add('hide-delta'))
            cards.forEach((card, i) => {
              const scoreEl = card.querySelector('.score')
              if (!scoreEl) return
              animateNumber(scoreEl, displayedScores[i], Number(nextScores[i] ?? 0), 1000, run)
            })
            scheduleScoreAnimation(run, () => {
              cards.forEach((card) => card.classList.add('info-return'))
              displayedScores = nextScores.map(Number)
              animationTargetScores = null
              scheduleScoreAnimation(run, () => {
                cards.forEach((card) => card.classList.remove('score-changing', 'show-delta', 'hide-delta', 'info-return'))
              }, 300)
            }, 1000)
          }, 900)
        }, 250)
      }

      function scheduleScoreAnimation(run, callback, delay) {
        const timer = window.setTimeout(() => {
          if (run === scoreAnimationRun) callback()
        }, delay)
        scoreAnimationTimers.push(timer)
        return timer
      }

      function cancelScoreAnimation(settle) {
        scoreAnimationRun += 1
        window.clearTimeout(animationTimer)
        scoreAnimationTimers.forEach((timer) => window.clearTimeout(timer))
        scoreAnimationTimers = []
        const cards = [...board.querySelectorAll('.player-lower')]
        if (settle && animationTargetScores) {
          displayedScores = animationTargetScores.map(Number)
          cards.forEach((card, i) => {
            const scoreEl = card.querySelector('.score')
            if (scoreEl) scoreEl.textContent = formatScore(displayedScores[i] ?? 0)
          })
        }
        cards.forEach((card) => {
          card.classList.remove('score-changing', 'show-delta', 'hide-delta', 'info-return')
          const delta = card.querySelector('.change-delta')
          const pool = card.querySelector('.pool-change')
          if (delta) delta.textContent = ''
          if (pool) {
            pool.innerHTML = ''
            pool.classList.remove('has-pool-change')
          }
        })
        animationTargetScores = null
      }

      function animateNumber(el, from, to, duration, run) {
        const start = performance.now()
        const tick = (now) => {
          if (run !== scoreAnimationRun) return
          const progress = Math.min(1, (now - start) / duration)
          const eased = 1 - Math.pow(1 - progress, 3)
          el.textContent = formatScore(Math.round(from + (to - from) * eased))
          if (progress < 1) {
            requestAnimationFrame(tick)
          } else {
            el.textContent = formatScore(to)
          }
        }
        requestAnimationFrame(tick)
      }

      function signedScore(value) {
        return `${value > 0 ? '+' : ''}${formatScore(value)}`
      }

      function renderPoolEntries(root, entries) {
        root.innerHTML = ''
        root.classList.toggle('has-pool-change', entries.length > 0)
        for (const value of entries) {
          const span = document.createElement('span')
          span.className = value >= 0 ? 'positive' : 'negative'
          span.textContent = signedScore(value)
          root.appendChild(span)
        }
      }

      function roundParts(round) {
        const wind = round.wind === '东' ? '東' : round.wind
        return [wind, String(round.number), '局']
      }

      function formatMatchDate(dateText) {
        const date = String(dateText ?? '')
        const m = date.match(/^\d{4}-(\d{1,2})-(\d{1,2})$/)
        if (!m) return 'Sep.11'
        return `${monthNames[Number(m[1]) - 1] ?? 'Sep'}.${Number(m[2])}`
      }

      function roundNumber(roundText) {
        const m = String(roundText ?? '').match(/\d+/)
        return m ? m[0].padStart(3, '0') : '001'
      }

      function traditionalSeat(value) {
        return ({ 东: '東', 南: '南', 西: '西', 北: '北' })[String(value)] ?? String(value)
      }

      function hexToRgb(hex) {
        const value = String(hex).replace('#', '')
        if (!/^[0-9a-f]{6}$/i.test(value)) return '36 42 51'
        return `${parseInt(value.slice(0, 2), 16)} ${parseInt(value.slice(2, 4), 16)} ${parseInt(value.slice(4, 6), 16)}`
      }

      function renderTiles(root, codes) {
        if (!root) return
        const visibleCodes = (codes ?? []).filter(Boolean)
        if (root === doraTiles) updateTopLeftBackground(visibleCodes)
        const existing = new Map([...root.querySelectorAll('.tile:not(.exiting)')].map((tile) => [tile.dataset.tileKey, tile]))
        const occurrences = new Map()
        const wanted = visibleCodes.map((code) => {
          const occurrence = occurrences.get(code) ?? 0
          occurrences.set(code, occurrence + 1)
          const key = `${code}-${occurrence}`
          const tile = existing.get(key)
          if (tile) {
            existing.delete(key)
            return tile
          }
          const inserted = buildTileImg(code)
          inserted.dataset.tileKey = key
          inserted.classList.add('entering')
          return inserted
        })
        existing.forEach((tile) => {
          tile.classList.remove('entering')
          tile.classList.add('exiting')
          window.setTimeout(() => {
            tile.remove()
            if (!root.querySelector('.tile:not(.exiting)')) root.classList.remove('has-tiles', 'tiles-exiting')
          }, 500)
        })
        let cursor = root.querySelector('.tile:not(.exiting)')
        wanted.forEach((tile) => {
          if (tile !== cursor) root.insertBefore(tile, cursor)
          if (tile.classList.contains('entering')) {
            window.setTimeout(() => tile.classList.remove('entering'), 900)
          }
          cursor = tile.nextElementSibling
          while (cursor?.classList.contains('exiting')) cursor = cursor.nextElementSibling
        })
        root.classList.toggle('has-tiles', wanted.length > 0 || existing.size > 0)
        root.classList.toggle('tiles-exiting', wanted.length === 0 && existing.size > 0)
      }

      function updateTopLeftBackground(doraCodes) {
        const count = Math.max(1, Math.min(4, doraCodes?.length ?? 0))
        const width = TOP_LEFT_BG_FULL_WIDTH - (4 - count) * DORA_BG_STEP
        overlay?.style.setProperty('--top-left-bg-width', `${width}px`)
      }

      function buildTileImg(code) {
        const img = document.createElement('img')
        img.className = 'tile'
        img.src = tileImageSrc(code)
        img.alt = tileLabel(code)
        return img
      }

      function formatScore(value) {
        return Number(value).toLocaleString('en-US')
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (ch) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        }[ch]))
      }

      const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

      window.addEventListener('storage', (event) => {
        if (event.key === key) {
          try {
            remoteState = event.newValue ? JSON.parse(event.newValue) : null
            render()
          } catch {
            remoteState = null
          }
        }
      })
      render()
      void pollRemoteState()
    </script>

