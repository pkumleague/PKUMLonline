---
import BaseLayout from '../../layouts/BaseLayout.astro'
import AdminShell from '../../components/admin/AdminShell.astro'
import StageTabs from '../../components/StageTabs.astro'
---
<BaseLayout title="赛程管理">
  <AdminShell requireRole="admin" allowReferee>
    <h1>赛程管理</h1>
    <div id="schedule-draft-bar" class="schedule-draft-bar" hidden>
      <span id="schedule-draft-status">存在未更新的赛程改动</span>
      <button type="button" id="schedule-publish">更新改动到前台</button>
    </div>
    <form id="game-form" class="game-form">
      <input name="season" value="26-27" required title="赛季（默认 26-27）">
      <select name="stage">
        <option value="常规赛">常规赛</option>
        <option value="半决赛">半决赛</option>
        <option value="决赛">决赛</option>
      </select>
      <input name="date" type="date" required>
      <input name="time" placeholder="时间 (如 14:00)">
      <input name="round" type="number" min="1" placeholder="半庄号（数字）" title="只需填数字，如 18">
      <select name="live">
        <option value="">待定</option>
        <option value="直播">直播</option>
        <option value="非直播">非直播</option>
      </select>
      <div class="game-seat-inputs">
        <select name="seat0" data-seat="东"></select>
        <select name="seat1" data-seat="南"></select>
        <select name="seat2" data-seat="西"></select>
        <select name="seat3" data-seat="北"></select>
      </div>
      <button type="submit" id="game-submit">新增</button>
      <button type="button" id="cancel-arrange" style="display:none">取消安排</button>
    </form>
    <p id="arrange-hint" class="arrange-hint" style="display:none"></p>
    <p id="game-err" class="admin-err"></p>
    <StageTabs stages={[{ name: '赛程' }, { name: '赛果' }]} />
    <section id="stage-0" class="stage-panel active">
      <div class="data-export-bar">
        <button type="button" id="schedule-export-toggle">导出数据</button>
        <button type="button" id="schedule-export-download" hidden disabled>统一导出</button>
        <button type="button" id="schedule-export-cancel" hidden>退出导出</button>
        <span id="schedule-export-count" hidden>已选择 0 项</span>
      </div>
      <table class="ann-table">
        <thead><tr><th id="schedule-export-head" hidden>选择</th><th>日期</th><th>阶段</th><th>半庄</th><th>对阵</th><th>操作</th></tr></thead>
        <tbody id="game-list-up"></tbody>
      </table>
      <div id="fill-panel"></div>
      <div class="unarranged-admin-head">
        <h2>未安排</h2>
        <button type="button" id="unarranged-add-toggle">新增未安排</button>
      </div>
      <form id="unarranged-form" class="game-form" style="display:none">
        <input name="useason" value="26-27" title="赛季（默认 26-27）">
        <select name="ustage">
          <option value="常规赛">常规赛</option>
          <option value="半决赛">半决赛</option>
          <option value="决赛">决赛</option>
        </select>
        <input name="useq" type="number" min="1" step="1" required title="序号（可手动填写，需唯一）" placeholder="序号">
        <div class="game-seat-inputs">
          <select name="useat0" data-seat="东"></select>
          <select name="useat1" data-seat="南"></select>
          <select name="useat2" data-seat="西"></select>
          <select name="useat3" data-seat="北"></select>
        </div>
        <button type="submit" id="unarranged-submit">新增未安排</button>
        <button type="button" id="unarranged-cancel">取消</button>
      </form>
      <p id="unarranged-err" class="admin-err"></p>
      <table class="ann-table">
        <thead><tr><th>序号</th><th>阶段</th><th>对阵</th><th>操作</th></tr></thead>
        <tbody id="unarranged-list"></tbody>
      </table>
    </section>
    <section id="stage-1" class="stage-panel">
      <div class="data-export-bar">
        <button type="button" id="result-export-toggle">导出数据</button>
        <button type="button" id="result-export-download" hidden disabled>统一导出</button>
        <button type="button" id="result-export-cancel" hidden>退出导出</button>
        <span id="result-export-count" hidden>已选择 0 项</span>
      </div>
      <table class="ann-table">
        <thead><tr><th id="result-export-head" hidden>选择</th><th>日期</th><th>阶段</th><th>半庄</th><th>对阵</th><th>操作</th></tr></thead>
        <tbody id="game-list-fin"></tbody>
      </table>
    </section>
  </AdminShell>
  <style is:global>
    .unarranged-admin-head { display: flex; align-items: center; justify-content: space-between; margin: 24px 0 10px; }
    .unarranged-admin-head h2 { margin: 0; }
    .schedule-draft-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 16px; padding: 10px 12px; border: 1px solid #b42318; border-radius: 6px; background: #fff4f2; color: #7a271a; font-weight: 700; }
    .schedule-draft-bar[hidden] { display: none; }
    .schedule-draft-bar button { padding: 9px 14px; border: 0; border-radius: 5px; background: #b42318; color: #fff; font-weight: 700; cursor: pointer; }
    .schedule-draft-bar button:hover { background: #8f1c13; }
    .arrange-hint { color: var(--accent); margin: 0 0 12px; }
    .fill-panel { margin-top: 16px; padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }
    .fill-panel h3 { margin: 0 0 10px; font-size: 18px; }
    .fill-seat { display: flex; align-items: center; gap: 10px; margin: 8px 0; font-size: 16px; }
    .fill-seat .fs-tag { display: inline-block; width: 44px; font-weight: 700; text-align: center; border-radius: 6px; padding: 4px 0; color: #fff; }
    .fill-seat .fs-team { width: 90px; }
    .fill-seat select { flex: 1; max-width: 240px; padding: 8px 8px; font-size: 16px; }
    .fill-actions { display: flex; gap: 10px; margin-top: 12px; }
    .fill-actions button { padding: 10px 20px; border-radius: 6px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 18px; }
    .fill-actions button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .data-export-bar { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; }
    .data-export-bar button { padding: 8px 14px; cursor: pointer; }
    .data-export-bar button[hidden], .data-export-bar span[hidden] { display: none; }
    .data-export-bar span { color: var(--muted); }
    .export-choice { width: 58px; text-align: center; }
    .export-choice input { width: 18px; height: 18px; cursor: pointer; }
  </style>
  <script>
    import { supabase } from '../../lib/supabase'
    import { buildResultExport, buildScheduleExport } from '../../lib/adminDataExport'
    import { buildSeats } from '../../lib/games'
    import { compareUpcoming, compareFinished } from '../../lib/schedule'
    import teamsRaw from '../../../data/teams.json'
    import rosterRaw from '../../../data/current_roster.json'
    const upList = document.getElementById('game-list-up')!
    const finList = document.getElementById('game-list-fin')!
    const form = document.getElementById('game-form') as HTMLFormElement
    const submitBtn = document.getElementById('game-submit') as HTMLButtonElement
    const errEl = document.getElementById('game-err')!
    const cancelArrangeBtn = document.getElementById('cancel-arrange') as HTMLButtonElement
    const arrangeHint = document.getElementById('arrange-hint')!
    const fillPanel = document.getElementById('fill-panel')!
    const unarrangedList = document.getElementById('unarranged-list')!
    const unarrangedForm = document.getElementById('unarranged-form') as HTMLFormElement
    const unarrangedSubmit = document.getElementById('unarranged-submit') as HTMLButtonElement
    const unarrangedErr = document.getElementById('unarranged-err')!
    const unarrangedToggle = document.getElementById('unarranged-add-toggle') as HTMLButtonElement
    const unarrangedCancel = document.getElementById('unarranged-cancel') as HTMLButtonElement
    const draftBar = document.getElementById('schedule-draft-bar')!
    const draftStatus = document.getElementById('schedule-draft-status')!
    const publishBtn = document.getElementById('schedule-publish') as HTMLButtonElement
    const scheduleExportToggle = document.getElementById('schedule-export-toggle') as HTMLButtonElement
    const scheduleExportDownload = document.getElementById('schedule-export-download') as HTMLButtonElement
    const scheduleExportCancel = document.getElementById('schedule-export-cancel') as HTMLButtonElement
    const scheduleExportCount = document.getElementById('schedule-export-count')!
    const scheduleExportHead = document.getElementById('schedule-export-head')!
    const resultExportToggle = document.getElementById('result-export-toggle') as HTMLButtonElement
    const resultExportDownload = document.getElementById('result-export-download') as HTMLButtonElement
    const resultExportCancel = document.getElementById('result-export-cancel') as HTMLButtonElement
    const resultExportCount = document.getElementById('result-export-count')!
    const resultExportHead = document.getElementById('result-export-head')!
    const base = import.meta.env.BASE_URL
    const TOKEN_KEY = 'pkuml_session_token'
    let editingId: string | null = null
    let arrangeUnarrangedId: string | null = null
    let unarrangedEditingId: string | null = null
    let role: string | null = null
    let teamsCache: string[] = []
    let gamesCache: any[] = []
    let unarrangedCache: any[] = []
    let publishedGameIds = new Set<string>()
    let hasScheduleDraft = false
    let publishingScheduleDraft = false
    let fillGame: any = null
    let fillSelects: HTMLSelectElement[] = []
    let scheduleExportMode = false
    let resultExportMode = false
    const selectedScheduleIds = new Set<string>()
    const selectedResultIds = new Set<string>()
    // 赛季__队伍名 -> roster
    const rosters = new Map<string, string[]>()
    const teamColorOf = (name: string) => teamsRaw.teams.find((t: any) => t.name === name)?.color ?? '#9ca3af'
    const showErr = (m: string) => { errEl.textContent = m }
    const showUnarrangedErr = (m: string) => { unarrangedErr.textContent = m }
    const seatSelects = () => [form.seat0, form.seat1, form.seat2, form.seat3]
    const unarrangedSeatSelects = () => [unarrangedForm.useat0, unarrangedForm.useat1, unarrangedForm.useat2, unarrangedForm.useat3]

    function lockScheduleIdentity(locked: boolean) {
      form.season.disabled = locked
      form.stage.disabled = locked
      seatSelects().forEach((select) => { select.disabled = locked })
    }

    async function scheduleDraftRequest(path = '', options: RequestInit = {}) {
      const token = localStorage.getItem(TOKEN_KEY)
      const headers: Record<string, string> = { 'Content-Type': 'application/json' }
      if (token) headers.Authorization = `Bearer ${token}`
      const res = await fetch(`${base}api/schedule-draft${path}`, { ...options, headers })
      const body = await res.json().catch(() => ({}))
      return { ok: res.ok, body, error: body?.error?.message ?? '请求失败' }
    }

    function updateDraftBar() {
      const visible = role === 'admin' && hasScheduleDraft
      draftBar.hidden = !visible
      if (visible) draftStatus.textContent = '存在未更新的赛程改动，前台仍显示上次发布内容'
    }

    function renderScheduleRows() {
      const upcoming = gamesCache.filter((g: any) => g.status === 'upcoming').sort(compareUpcoming)
      const finished = gamesCache.filter((g: any) => g.status === 'finished').sort(compareFinished)
      renderRows(upList, upcoming, '暂无赛程。')
      renderRows(finList, finished, '暂无赛果。')
      renderUnarrangedRows()
    }

    function updateExportControls() {
      scheduleExportToggle.hidden = scheduleExportMode
      scheduleExportDownload.hidden = !scheduleExportMode
      scheduleExportCancel.hidden = !scheduleExportMode
      scheduleExportCount.hidden = !scheduleExportMode
      scheduleExportHead.hidden = !scheduleExportMode
      scheduleExportDownload.disabled = selectedScheduleIds.size === 0
      scheduleExportCount.textContent = `已选择 ${selectedScheduleIds.size} 项`

      resultExportToggle.hidden = resultExportMode
      resultExportDownload.hidden = !resultExportMode
      resultExportCancel.hidden = !resultExportMode
      resultExportCount.hidden = !resultExportMode
      resultExportHead.hidden = !resultExportMode
      resultExportDownload.disabled = selectedResultIds.size === 0
      resultExportCount.textContent = `已选择 ${selectedResultIds.size} 项`
    }

    async function saveScheduleDraft() {
      const res = await scheduleDraftRequest('', {
        method: 'PUT',
        body: JSON.stringify({ games: gamesCache, unarranged: unarrangedCache }),
      })
      if (!res.ok) return res.error
      hasScheduleDraft = true
      updateDraftBar()
      renderScheduleRows()
      return null
    }

    function fillTeamSelect(sel: HTMLSelectElement) {
      sel.innerHTML = ''
      const opt = document.createElement('option')
      opt.value = ''; opt.textContent = '选择队伍'
      sel.appendChild(opt)
      for (const n of teamsCache) {
        const o = document.createElement('option'); o.value = n; o.textContent = n
        sel.appendChild(o)
      }
    }
    async function loadTeams() {
      // 队伍名来自静态 teams.json（名单真源 current_roster.json）
      teamsCache = teamsRaw.teams.map((t: any) => t.name)
      for (const s of seatSelects()) fillTeamSelect(s)
      for (const s of unarrangedSeatSelects()) fillTeamSelect(s)
    }
    function loadRosters() {
      // 名单真源：data/current_roster.json（静态），按 赛季__队伍 缓存
      rosters.clear()
      for (const t of rosterRaw.teams ?? []) rosters.set(`${rosterRaw.season}__${t.name}`, t.roster ?? [])
    }
    function rosterOf(season: string, team: string): string[] {
      return rosters.get(`${season}__${team}`) ?? []
    }
    async function loadGames() {
      const { data, error } = await supabase.from('games').select('*').order('date', { ascending: true })
      if (error) return showErr('加载失败：' + error.message)
      errEl.textContent = ''
      gamesCache = data ?? []
      publishedGameIds = new Set(gamesCache.map((game: any) => game.id))
      // 排序与前台一致：赛程 = 阶段正序→日期升序→半庄号升序；赛果 = 相反
      const upcoming = (data ?? []).filter((g: any) => g.status === 'upcoming').sort(compareUpcoming)
      const finished = (data ?? []).filter((g: any) => g.status === 'finished').sort(compareFinished)
      renderRows(upList, upcoming, '暂无赛程。')
      renderRows(finList, finished, '暂无赛果。')
    }

    async function loadUnarranged() {
      const { data, error } = await supabase
        .from('unarranged_games').select('*').order('seq', { ascending: true })
      if (error) return showUnarrangedErr('加载失败：' + error.message)
      unarrangedErr.textContent = ''
      unarrangedCache = data ?? []
      renderUnarrangedRows()
    }

    async function load() {
      if (role === 'admin') {
        const res = await scheduleDraftRequest()
        if (!res.ok) return showErr('加载赛程草稿失败：' + res.error)
        const { data } = res.body
        gamesCache = data?.games ?? []
        unarrangedCache = data?.unarranged ?? []
        hasScheduleDraft = Boolean(data?.hasChanges)
        const { data: published, error } = await supabase.from('games').select('*').order('date', { ascending: true })
        if (error) return showErr('加载已发布赛程失败：' + error.message)
        publishedGameIds = new Set((published ?? []).map((game: any) => game.id))
        updateDraftBar()
        renderScheduleRows()
        return
      }
      await Promise.all([loadGames(), loadUnarranged()])
    }

    function renderRows(tbody: HTMLElement, games: any[], emptyText: string) {
      tbody.innerHTML = ''
      const isScheduleList = tbody === upList
      const exportMode = isScheduleList ? scheduleExportMode : resultExportMode
      const selectedIds = isScheduleList ? selectedScheduleIds : selectedResultIds
      if (games.length === 0) {
        const tr = document.createElement('tr')
        const td = document.createElement('td')
        td.colSpan = exportMode ? 6 : 5
        td.textContent = emptyText
        td.style.color = 'var(--muted)'
        tr.appendChild(td)
        tbody.appendChild(tr)
        return
      }
      for (const g of games) {
        const tr = document.createElement('tr')
        const td = (s: string) => { const x = document.createElement('td'); x.textContent = s; tr.appendChild(x) }
        if (exportMode) {
          const choice = document.createElement('td')
          choice.className = 'export-choice'
          const checkbox = document.createElement('input')
          checkbox.type = 'checkbox'
          checkbox.checked = selectedIds.has(g.id)
          checkbox.setAttribute('aria-label', `选择${g.date ?? ''}${g.round ?? ''}`)
          checkbox.addEventListener('change', () => {
            if (checkbox.checked) selectedIds.add(g.id)
            else selectedIds.delete(g.id)
            updateExportControls()
          })
          choice.appendChild(checkbox)
          tr.appendChild(choice)
        }
        td(g.date); td(g.stage); td(g.round ?? '')
        td((g.seats ?? []).map((s: { team: string }) => s.team).join(' / '))
        const ops = document.createElement('td')
        const canOperate = role === 'admin' || role === 'referee'
        // 管理员专属操作：改 / 删（裁判不可改赛程，RLS 也会拒绝）
        if (role === 'admin') {
          const eb = document.createElement('button'); eb.textContent = '改'; eb.dataset.edit = g.id
          const db = document.createElement('button'); db.textContent = '删'; db.dataset.del = g.id
          ops.append(eb, db)
        }
        if (canOperate && g.status === 'upcoming' && publishedGameIds.has(g.id)) {
          // 填选手：admin 与裁判均可（裁判拥有所有队长填人权限之和）
          const fb = document.createElement('button'); fb.textContent = '填选手'; fb.dataset.fill = g.id
          fb.style.marginLeft = '8px'
          ops.appendChild(fb)
          // 录赛果：直接录入最终分数；逐局录入：按小局逐步录入
          const link = document.createElement('a')
          link.href = base + 'admin/match/result/?id=' + encodeURIComponent(g.id)
          link.textContent = '录赛果'
          link.style.marginLeft = '8px'
          ops.appendChild(link)
          const rl = document.createElement('a')
          rl.href = base + 'admin/match/?id=' + encodeURIComponent(g.id)
          rl.textContent = '逐局录入'
          rl.style.marginLeft = '8px'
          ops.appendChild(rl)
          const liveLink = document.createElement('a')
          liveLink.href = base + 'admin/live-control/?id=' + encodeURIComponent(g.id)
          liveLink.textContent = '直播控制台'
          liveLink.style.marginLeft = '8px'
          ops.appendChild(liveLink)
        } else if (canOperate && g.status === 'finished') {
          const link = document.createElement('a')
          link.href = base + 'match/?id=' + encodeURIComponent(g.id)
          link.textContent = '赛果'
          link.style.marginLeft = '8px'
          ops.appendChild(link)
          if (role === 'admin') {
            const editLink = document.createElement('a')
            editLink.href = base + 'admin/match/result/?id=' + encodeURIComponent(g.id)
            editLink.textContent = '改赛果'
            editLink.style.marginLeft = '8px'
            ops.appendChild(editLink)
            const roundLink = document.createElement('a')
            roundLink.href = base + 'admin/match/?id=' + encodeURIComponent(g.id)
            roundLink.textContent = '逐局补录'
            roundLink.style.marginLeft = '8px'
            ops.appendChild(roundLink)
          }
        }
        tr.appendChild(ops)
        tbody.appendChild(tr)
      }
    }

    // ---------- 未安排赛程 ----------
    function renderUnarrangedRows() {
      unarrangedList.innerHTML = ''
      if (unarrangedCache.length === 0) {
        const tr = document.createElement('tr')
        const td = document.createElement('td')
        td.colSpan = 4
        td.textContent = '暂无未安排赛程。'
        td.style.color = 'var(--muted)'
        tr.appendChild(td)
        unarrangedList.appendChild(tr)
        return
      }
      for (const u of unarrangedCache) {
        const tr = document.createElement('tr')
        const td = (s: string) => { const x = document.createElement('td'); x.textContent = s; tr.appendChild(x) }
        td(String(u.seq)); td(u.stage)
        td((u.seats ?? []).map((s: any) => s.team).join(' / '))
        const ops = document.createElement('td')
        if (role === 'admin') {
          const ab = document.createElement('button'); ab.textContent = '安排'; ab.dataset.arrange = u.id
          const eb = document.createElement('button'); eb.textContent = '改'; eb.dataset.editU = u.id
          const db = document.createElement('button'); db.textContent = '删'; db.dataset.delU = u.id
          ops.append(ab, eb, db)
        }
        tr.appendChild(ops)
        unarrangedList.appendChild(tr)
      }
    }

    function openUnarrangedForm(u?: any) {
      unarrangedForm.style.display = 'flex'
      unarrangedToggle.textContent = '收起新增'
      unarrangedErr.textContent = ''
      if (u) {
        unarrangedEditingId = u.id
        unarrangedForm.useason.value = u.season
        unarrangedForm.ustage.value = u.stage
        unarrangedForm.useq.value = String(u.seq ?? '')
        const seats = u.seats ?? []
        unarrangedSeatSelects().forEach((s, i) => { s.value = seats[i]?.team ?? '' })
        unarrangedSubmit.textContent = '保存未安排'
      } else {
        unarrangedEditingId = null
        unarrangedForm.reset()
        unarrangedForm.useason.value = '26-27'
        const maxSeq = unarrangedCache.reduce((m: number, x: any) => Math.max(m, Number(x.seq) || 0), 0)
        unarrangedForm.useq.value = String(maxSeq + 1)
        unarrangedSubmit.textContent = '新增未安排'
      }
      window.scrollTo({ top: unarrangedForm.offsetTop - 80, behavior: 'smooth' })
    }

    function closeUnarrangedForm() {
      unarrangedForm.style.display = 'none'
      unarrangedEditingId = null
      unarrangedToggle.textContent = '新增未安排'
      unarrangedErr.textContent = ''
    }

    function startArrange(u: any) {
      editingId = null
      arrangeUnarrangedId = u.id
      lockScheduleIdentity(false)
      form.season.value = u.season
      form.stage.value = u.stage
      form.date.value = ''
      form.time.value = ''
      form.round.value = ''
      form.live.value = ''
      const seats = u.seats ?? []
      seatSelects().forEach((s, i) => { s.value = seats[i]?.team ?? '' })
      submitBtn.textContent = '保存并安排'
      cancelArrangeBtn.style.display = 'inline-block'
      arrangeHint.textContent = `正在安排未安排 #${u.seq}（${(seats || []).map((s: any) => s.team).join(' / ')}），请填写日期、时间、半庄号、直播状态后提交。`
      arrangeHint.style.display = ''
      window.scrollTo({ top: form.offsetTop - 80, behavior: 'smooth' })
    }

    function cancelArrange() {
      arrangeUnarrangedId = null
      editingId = null
      lockScheduleIdentity(false)
      submitBtn.textContent = '新增'
      cancelArrangeBtn.style.display = 'none'
      arrangeHint.style.display = 'none'
      form.reset()
      form.season.value = '26-27'
    }

    // ---------- 管理员代填选手 ----------
    function openFill(g: any) {
      fillGame = g
      fillPanel.innerHTML = ''
      const box = document.createElement('div')
      box.className = 'fill-panel'
      const title = document.createElement('h3')
      title.textContent = `填选手：${g.date} · ${g.stage}${g.round ? ' ' + g.round : ''}`
      box.appendChild(title)
      fillSelects = []
      ;(g.seats ?? []).forEach((s: any) => {
        const row = document.createElement('div')
        row.className = 'fill-seat'
        const tag = document.createElement('span')
        tag.className = 'fs-tag'
        tag.style.background = teamColorOf(s.team)
        tag.textContent = s.seat
        const team = document.createElement('span')
        team.className = 'fs-team'
        team.textContent = s.team
        const sel = document.createElement('select')
        const empty = document.createElement('option')
        empty.value = ''
        empty.textContent = '未选定'
        sel.appendChild(empty)
        for (const p of rosterOf(g.season, s.team)) {
          const o = document.createElement('option')
          o.value = p
          o.textContent = p
          sel.appendChild(o)
        }
        sel.value = s.player ?? ''
        fillSelects.push(sel)
        row.append(tag, team, sel)
        box.appendChild(row)
      })
      const actions = document.createElement('div')
      actions.className = 'fill-actions'
      const saveBtn = document.createElement('button')
      saveBtn.className = 'primary'
      saveBtn.textContent = '保存'
      saveBtn.addEventListener('click', saveFill)
      const cancelBtn = document.createElement('button')
      cancelBtn.textContent = '关闭'
      cancelBtn.addEventListener('click', closeFill)
      actions.append(saveBtn, cancelBtn)
      box.appendChild(actions)
      fillPanel.appendChild(box)
      window.scrollTo({ top: fillPanel.offsetTop - 80, behavior: 'smooth' })
    }
    function closeFill() {
      fillGame = null
      fillPanel.innerHTML = ''
    }
    async function saveFill() {
      if (!fillGame) return
      const seats = fillSelects.map((sel, i) => ({
        seat: fillGame.seats[i].seat,
        team: fillGame.seats[i].team,
        player: sel.value || null,
      }))
      const { error } = await supabase.rpc('fill_players', { p_game_id: fillGame.id, p_seats: seats })
      if (error) return showErr('保存选手失败：' + error.message)
      closeFill()
      load()
    }
    const onListClick = async (e: Event) => {
      const el = e.target as HTMLElement
      const id = el.dataset.del ?? el.dataset.edit ?? ''
      if (el.dataset.del) {
        if (!window.confirm('确定删除这场赛程吗？该改动将在发布到前台后生效。')) return
        gamesCache = gamesCache.filter((game) => game.id !== id)
        const error = await saveScheduleDraft()
        if (error) return showErr('删除失败：' + error)
      } else if (el.dataset.fill) {
        const { data, error } = await supabase.from('games').select('*').eq('id', el.dataset.fill).single()
        if (error) return showErr('加载失败：' + error.message)
        if (data) openFill(data)
      } else if (el.dataset.edit) {
        const game = gamesCache.find((item) => item.id === id)
        if (game) {
          editingId = game.id
          arrangeUnarrangedId = null
          cancelArrangeBtn.style.display = 'none'
          arrangeHint.style.display = 'none'
          form.season.value = game.season
          form.stage.value = game.stage
          form.date.value = game.date
          form.time.value = game.time ?? ''
          form.live.value = game.live_status ?? ''
          form.round.value = (game.round ?? '').match(/(\d+)/)?.[1] ?? ''
          const seats = game.seats ?? []
          seatSelects().forEach((s, i) => { s.value = seats[i]?.team ?? '' })
          lockScheduleIdentity(true)
          submitBtn.textContent = '保存'
        }
      }
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const teams = seatSelects().map((s) => s.value)
      if (teams.some((t) => !t)) return showErr('请为每个座位选择队伍')
      if (arrangeUnarrangedId) {
        if (!form.date.value) return showErr('请填写日期')
        const unarranged = unarrangedCache.find((game) => game.id === arrangeUnarrangedId)
        if (!unarranged) return showErr('未找到待安排赛程')
        gamesCache.push({
          id: crypto.randomUUID(),
          season: form.season.value.trim(),
          stage: form.stage.value,
          date: form.date.value,
          time: form.time.value.trim() || null,
          round: form.round.value.trim() ? `第${form.round.value.trim()}半庄` : null,
          status: 'upcoming',
          live_status: form.live.value.trim() || null,
          seats: buildSeats(teams),
        })
        unarrangedCache = unarrangedCache.filter((game) => game.id !== arrangeUnarrangedId)
        const error = await saveScheduleDraft()
        if (error) return showErr('安排失败：' + error)
        cancelArrange()
        form.reset(); form.season.value = '26-27'
        return
      }
      const editableFields = {
        date: form.date.value,
        time: form.time.value.trim() || null,
        round: form.round.value.trim() ? `第${form.round.value.trim()}半庄` : null,
        live_status: form.live.value.trim() || null,
      }
      if (editingId) {
        // 编辑只更新赛程信息，完整保留原 seats（含已经填写的选手）。
        gamesCache = gamesCache.map((game) => game.id === editingId ? { ...game, ...editableFields } : game)
        editingId = null; submitBtn.textContent = '新增'
        lockScheduleIdentity(false)
      } else {
        const payload = {
          season: form.season.value.trim(),
          stage: form.stage.value,
          ...editableFields,
          seats: buildSeats(teams),
        }
        gamesCache.push({ id: crypto.randomUUID(), status: 'upcoming', ...payload })
      }
      const error = await saveScheduleDraft()
      if (error) return showErr('保存失败：' + error)
      form.reset(); form.season.value = '26-27'
    })
    upList.addEventListener('click', onListClick)
    finList.addEventListener('click', onListClick)
    const onUnarrangedListClick = async (e: Event) => {
      const el = e.target as HTMLElement
      const id = el.dataset.arrange ?? el.dataset.editU ?? el.dataset.delU ?? ''
      const u = unarrangedCache.find((x) => x.id === id)
      if (el.dataset.arrange && u) {
        startArrange(u)
      } else if (el.dataset.editU && u) {
        openUnarrangedForm(u)
      } else if (el.dataset.delU) {
        if (!window.confirm('确定删除这条未安排赛程吗？该改动将在发布到前台后生效。')) return
        unarrangedCache = unarrangedCache.filter((game) => game.id !== id)
        const error = await saveScheduleDraft()
        if (error) return showUnarrangedErr('删除失败：' + error)
      }
    }
    unarrangedList.addEventListener('click', onUnarrangedListClick)
    unarrangedToggle.addEventListener('click', () => {
      if (unarrangedForm.style.display === 'none') openUnarrangedForm()
      else closeUnarrangedForm()
    })
    unarrangedCancel.addEventListener('click', closeUnarrangedForm)
    cancelArrangeBtn.addEventListener('click', cancelArrange)
    unarrangedForm.addEventListener('submit', async (e) => {
      e.preventDefault()
      const teams = unarrangedSeatSelects().map((s) => s.value)
      if (teams.some((t) => !t)) return showUnarrangedErr('请为每个座位选择队伍')
      const seq = Number(unarrangedForm.useq.value)
      if (!Number.isInteger(seq) || seq < 1) return showUnarrangedErr('序号须为正整数')
      const existing = unarrangedEditingId ? unarrangedCache.find((x) => x.id === unarrangedEditingId) : null
      const season = unarrangedForm.useason.value.trim()
      const stage = unarrangedForm.ustage.value
      const duplicate = unarrangedCache.some(
        (x) => x.id !== existing?.id && x.season === season && x.stage === stage && Number(x.seq) === seq,
      )
      if (duplicate) return showUnarrangedErr('该赛季该阶段序号已存在，请换一个序号')
      const payload = {
        season,
        stage,
        seq,
        seats: buildSeats(teams),
      }
      if (existing) {
        unarrangedCache = unarrangedCache.map((game) => game.id === existing.id ? { ...game, ...payload } : game)
      } else {
        unarrangedCache.push({ id: crypto.randomUUID(), ...payload })
      }
      const error = await saveScheduleDraft()
      if (error) return showUnarrangedErr('保存失败：' + error)
      closeUnarrangedForm()
    })
    publishBtn.addEventListener('click', async () => {
      if (!hasScheduleDraft || publishingScheduleDraft) return
      publishingScheduleDraft = true
      publishBtn.disabled = true
      const res = await scheduleDraftRequest('/publish', { method: 'POST' })
      publishingScheduleDraft = false
      publishBtn.disabled = false
      if (!res.ok) return showErr('更新前台失败：' + res.error)
      hasScheduleDraft = false
      await load()
    })
    async function discardScheduleDraftOnLeave() {
      if (!hasScheduleDraft || publishingScheduleDraft) return
      const token = localStorage.getItem(TOKEN_KEY)
      const headers: Record<string, string> = { 'Content-Type': 'application/json' }
      if (token) headers.Authorization = `Bearer ${token}`
      try {
        await fetch(`${base}api/schedule-draft/discard`, { method: 'POST', headers, keepalive: true })
      } catch {
        // The browser is already leaving; the next admin visit can still discard a stale draft.
      }
    }

    function downloadJson(payload: unknown, filename: string) {
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' })
      const url = URL.createObjectURL(blob)
      const link = document.createElement('a')
      link.href = url
      link.download = filename
      document.body.appendChild(link)
      link.click()
      link.remove()
      URL.revokeObjectURL(url)
    }

    function beginScheduleExport() {
      selectedScheduleIds.clear()
      scheduleExportMode = true
      updateExportControls()
      renderScheduleRows()
    }

    function cancelScheduleExport() {
      selectedScheduleIds.clear()
      scheduleExportMode = false
      updateExportControls()
      renderScheduleRows()
    }

    function beginResultExport() {
      selectedResultIds.clear()
      resultExportMode = true
      updateExportControls()
      renderScheduleRows()
    }

    function cancelResultExport() {
      selectedResultIds.clear()
      resultExportMode = false
      updateExportControls()
      renderScheduleRows()
    }

    scheduleExportToggle.addEventListener('click', beginScheduleExport)
    scheduleExportCancel.addEventListener('click', cancelScheduleExport)
    scheduleExportDownload.addEventListener('click', () => {
      const games = gamesCache
        .filter((game: any) => game.status === 'upcoming' && selectedScheduleIds.has(game.id))
        .sort(compareUpcoming)
      if (games.length === 0) return
      downloadJson(buildScheduleExport(games), `赛程数据-${new Date().toISOString().slice(0, 10)}.json`)
    })
    resultExportToggle.addEventListener('click', beginResultExport)
    resultExportCancel.addEventListener('click', cancelResultExport)
    resultExportDownload.addEventListener('click', () => {
      const games = gamesCache
        .filter((game: any) => game.status === 'finished' && selectedResultIds.has(game.id))
        .sort(compareFinished)
      if (games.length === 0) return
      downloadJson(buildResultExport(games), `赛果数据-${new Date().toISOString().slice(0, 10)}.json`)
    })
    window.addEventListener('beforeunload', (event) => {
      if (!hasScheduleDraft || publishingScheduleDraft) return
      event.preventDefault()
      event.returnValue = ''
    })
    window.addEventListener('pagehide', (event) => {
      if (event.persisted) return
      void discardScheduleDraftOnLeave()
    })
    // 赛程/赛果标签切换（默认显示赛程）
    document.querySelectorAll('.stage-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.stage-tab').forEach((t) => t.classList.remove('active'))
        document.querySelectorAll('.stage-panel').forEach((p) => p.classList.remove('active'))
        tab.classList.add('active')
        document.getElementById(tab.dataset.target ?? '')?.classList.add('active')
      })
    })
    ;(async () => {
      const { data: { session } } = await supabase.auth.getSession()
      if (!session) return
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single()
      role = profile?.role ?? null
      // 裁判只能查看赛程并进入录入，不能新增/编辑/删除赛程/安排未安排
      if (role !== 'admin') {
        form.style.display = 'none'
        unarrangedToggle.style.display = 'none'
        unarrangedForm.style.display = 'none'
      }
      loadTeams(); loadRosters(); load()
    })()
  </script>
</BaseLayout>
