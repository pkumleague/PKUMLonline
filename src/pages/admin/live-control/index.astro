---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import AdminShell from '../../../components/admin/AdminShell.astro'
---
<BaseLayout title="直播控制台">
  <AdminShell>
    <h1>直播控制台</h1>
    <p id="live-err" class="admin-err"></p>
    <div id="live-root" class="live-root">
      <p class="empty">加载中...</p>
    </div>
  </AdminShell>

  <style is:global>
    .live-root { display: grid; gap: 16px; }
    .live-grid { display: grid; grid-template-columns: minmax(360px, 1.1fr) minmax(360px, .9fr); gap: 16px; align-items: start; }
    .live-panel { border: 1px solid var(--line); border-radius: 8px; background: var(--card); padding: 14px; }
    .live-panel h2 { margin: 0 0 10px; font-size: 20px; }
    .live-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 10px 0; }
    .live-row label { display: inline-flex; gap: 6px; align-items: center; font-size: 15px; }
    .live-row input[type='text'], .live-row input[type='number'] { padding: 7px 9px; border: 1px solid var(--line); border-radius: 6px; font-size: 15px; }
    .live-row input[type='number'] { width: 108px; text-align: right; font-variant-numeric: tabular-nums; }
    .live-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
    .live-actions button, .live-row button, .seat-pick button, .point-btn, .tier-btn {
      padding: 8px 13px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: var(--card);
      cursor: pointer;
      font-size: 15px;
    }
    .live-actions button.primary, .live-row button.primary, .seat-pick button.sel, .point-btn.sel, .tier-btn.sel {
      border-color: var(--accent);
      background: var(--accent);
      color: #fff;
    }
    .live-actions button.danger { border-color: #b91c1c; color: #b91c1c; }
    .seat-pick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; width: 100%; }
    .seat-pick button { min-width: 0; text-align: left; }
    .seat-name { display: block; font-weight: 800; }
    .seat-team { display: block; color: var(--muted); font-size: 12px; }
    .score-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .score-card { color: #fff; border-radius: 8px; padding: 12px; background: var(--team-color, #222); box-shadow: inset 0 0 0 999px rgb(0 0 0 / 22%); }
    .score-card.dealer { outline: 5px solid #d71920; outline-offset: -5px; }
    .score-card .label { font-size: 13px; opacity: .9; }
    .score-card .value { font-size: 28px; font-weight: 900; font-variant-numeric: tabular-nums; }
    .tile-preview { display: flex; gap: 5px; min-height: 46px; align-items: center; }
    .tile-preview img { width: 32px; height: 44px; object-fit: contain; }
    .dora-inputs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .dora-inputs input[type='text'] { width: 58px; text-align: center; }
    .input-picker-pair { display: inline-flex; gap: 2px; align-items: center; }
    .tile-picker-open { padding: 7px 10px !important; white-space: nowrap; }
    .tile-picker-backdrop { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 24px; background: rgb(0 0 0 / 62%); }
    .tile-picker-dialog { width: min(1080px, 100%); max-height: calc(100vh - 48px); overflow: auto; padding: 24px; border-radius: 14px; background: #f7f8fa; box-shadow: 0 24px 80px rgb(0 0 0 / 45%); }
    .tile-picker-dialog h2 { margin: 0; font-size: 24px; }
    .tile-picker-note { margin: 8px 0 18px; color: var(--muted); }
    .tile-picker-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }
    .tile-picker-actions button { padding: 9px 15px; border: 1px solid var(--line); border-radius: 7px; background: #fff; cursor: pointer; font-size: 16px; }
    .tile-picker-actions .confirm { border-color: var(--accent); background: var(--accent); color: #fff; }
    .tile-picker-actions .confirm:disabled { cursor: not-allowed; opacity: .45; }
    .tile-picker-suit-row { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--line); }
    .tile-picker-suit-row strong { font-size: 16px; }
    .tile-picker-tiles { display: flex; flex-wrap: wrap; gap: 8px; }
    .tile-picker-tile { display: grid; place-items: center; box-sizing: border-box; width: 64px; height: 86px; padding: 4px; border: 4px solid transparent; border-radius: 8px; background: #fff; cursor: pointer; }
    .tile-picker-tile img { width: 50px; height: 70px; object-fit: contain; }
    .tile-picker-tile.is-selected { border-color: #177a37; background: #e8f6ec; box-shadow: 0 0 0 2px rgb(23 122 55 / 35%); }
    .points-grid { max-height: 310px; overflow: auto; border: 1px solid var(--line); border-radius: 8px; }
    .points-grid table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .points-grid th, .points-grid td { border-bottom: 1px solid var(--line); padding: 4px; text-align: center; white-space: nowrap; }
    .point-btn { width: 100%; padding: 6px 8px; font-variant-numeric: tabular-nums; }
    .tier-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .round-list { max-height: 300px; overflow: auto; }
    .round-list table { font-size: 14px; }
    .round-reset-row td { background: var(--accent-soft); color: var(--muted); font-weight: 700; text-align: center; }
    .restart-panel { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); }
    .restart-panel h2 { margin: 0 0 10px; font-size: 20px; }
    .import-hint { color: var(--muted); font-size: 13px; }
    .overlay-link { word-break: break-all; }
    @media (max-width: 980px) {
      .live-grid { grid-template-columns: 1fr; }
      .score-strip { grid-template-columns: repeat(2, 1fr); }
      .tile-picker-suit-row { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import teamsRaw from '../../../../data/teams.json'
    import pointsRaw from '../../../../data/points_table.json'
    import { supabase } from '../../../lib/supabase'
    import { dealerSeat, nextRound, settleRound } from '../../../lib/scoring'
    import { replayGame, roundLabel, seatLabel } from '../../../lib/replay'
    import { liveStorageKey, emptyLiveOnly, parseTileInput, tileImageSrc, tileLabel } from '../../../lib/live'
    import type { RoundResult, RoundState } from '../../../lib/scoring'
    import type { StoredRound } from '../../../lib/replay'
    import type { PointsTable } from '../../../lib/types'

    const points = pointsRaw as PointsTable
    const base = import.meta.env.BASE_URL
    const errEl = document.getElementById('live-err')!
    const root = document.getElementById('live-root')!
    const params = new URLSearchParams(location.search)
    const gameId = params.get('id')
    const teams = new Map((teamsRaw.teams ?? []).map((team: any) => [team.name, team.color]))
    const TOKEN_KEY = 'pkuml_session_token'
    let publishTimer: ReturnType<typeof setTimeout> | null = null

    const FU = ['20', '25', '30', '40', '50', '60', '70']
    const HAN = ['1', '2', '3', '4']
    const PICKER_TILE_ROWS = [
      { label: '万子', codes: Array.from({ length: 9 }, (_, i) => `${i + 1}m`) },
      { label: '筒子', codes: Array.from({ length: 9 }, (_, i) => `${i + 1}p`) },
      { label: '索子', codes: Array.from({ length: 9 }, (_, i) => `${i + 1}s`) },
      { label: '字牌', codes: Array.from({ length: 7 }, (_, i) => `${i + 1}z`) },
    ]
    const PICKER_TILE_ORDER = PICKER_TILE_ROWS.flatMap((row) => row.codes)

    let game: any = null
    let role: string | null = null
    let rounds: StoredRound[] = []
    let currentDora: string[] = []
    let currentWaits: string[][] = [[], [], [], []]
    let liveOnly = emptyLiveOnly()
    let editingOrder: number | null = null
    let editMode: 'edit' | 'rewind' | null = null
    let editState: { round: RoundState; pool: number; scores: number[] } | null = null
    let resetDraft: { wind: RoundState['wind']; number: RoundState['number']; honba: number; pool: number; scores: number[] } | null = null

    const form: {
      winType: 'ron' | 'tsumo' | 'draw' | null
      riichi: boolean[]
      winner: number | null
      loser: number | null
      ronPoints: number | null
      tsumoSplit: number[] | null
      tenpai: boolean[]
      selKey: string | null
    } = {
      winType: null,
      riichi: [false, false, false, false],
      winner: null,
      loser: null,
      ronPoints: null,
      tsumoSplit: null,
      tenpai: [false, false, false, false],
      selKey: null,
    }

    function showErr(message: string) { errEl.textContent = message }
    function clearErr() { errEl.textContent = '' }
    function el(tag: string, cls = '', text = ''): HTMLElement {
      const node = document.createElement(tag)
      if (cls) node.className = cls
      if (text) node.textContent = text
      return node
    }

    function openTilePicker(mode: 'dora' | 'wait', initialCodes: string[] = []): Promise<string | null> {
      return new Promise((resolve) => {
        const backdrop = el('div', 'tile-picker-backdrop')
        const dialog = el('section', 'tile-picker-dialog')
        let selected = new Set(initialCodes.filter((code) => PICKER_TILE_ORDER.includes(code)))
        const previousOverflow = document.body.style.overflow

        const sortedSelection = () => [...selected].sort(
          (a, b) => PICKER_TILE_ORDER.indexOf(a) - PICKER_TILE_ORDER.indexOf(b),
        )
        const confirmValue = () => mode === 'dora'
          ? sortedSelection()[0] ?? null
          : sortedSelection().join('') || null
        const close = (value: string | null) => {
          document.removeEventListener('keydown', onKeydown)
          document.body.style.overflow = previousOverflow
          backdrop.remove()
          resolve(value)
        }
        const onKeydown = (event: KeyboardEvent) => {
          if (event.key === 'Escape') close(null)
        }
        const selectTile = (code: string) => {
          if (mode === 'dora') selected = new Set([code])
          else if (selected.has(code)) selected.delete(code)
          else selected.add(code)
          renderPicker()
        }
        const renderPicker = () => {
          dialog.innerHTML = ''
          dialog.appendChild(el('h2', '', mode === 'dora' ? '选择宝牌' : '选择听牌'))
          dialog.appendChild(el(
            'p',
            'tile-picker-note',
            mode === 'dora' ? '一次只能选择一张普通麻将牌。' : '可选择多种听牌，重复点击会取消选择。',
          ))
          const rows = el('div', 'tile-picker-rows')
          for (const row of PICKER_TILE_ROWS) {
            const rowEl = el('div', 'tile-picker-suit-row')
            rowEl.appendChild(el('strong', '', row.label))
            const tileList = el('div', 'tile-picker-tiles')
            for (const code of row.codes) {
              const button = el('button', 'tile-picker-tile') as HTMLButtonElement
              button.type = 'button'
              button.classList.toggle('is-selected', selected.has(code))
              const image = document.createElement('img')
              image.src = tileImageSrc(code)
              image.alt = tileLabel(code)
              button.appendChild(image)
              button.addEventListener('click', () => selectTile(code))
              tileList.appendChild(button)
            }
            rowEl.appendChild(tileList)
            rows.appendChild(rowEl)
          }
          dialog.appendChild(rows)
          const actions = el('div', 'tile-picker-actions')
          const cancel = el('button', 'cancel', '退出') as HTMLButtonElement
          cancel.type = 'button'
          cancel.addEventListener('click', () => close(null))
          const confirm = el('button', 'confirm', '确认') as HTMLButtonElement
          confirm.type = 'button'
          confirm.disabled = !confirmValue()
          confirm.addEventListener('click', () => close(confirmValue()))
          actions.append(cancel, confirm)
          dialog.appendChild(actions)
        }

        backdrop.addEventListener('click', (event) => {
          if (event.target === backdrop) close(null)
        })
        backdrop.appendChild(dialog)
        document.body.appendChild(backdrop)
        document.body.style.overflow = 'hidden'
        document.addEventListener('keydown', onKeydown)
        renderPicker()
      })
    }

    function inputPickerPair(input: HTMLInputElement, mode: 'dora' | 'wait') {
      const pair = el('span', 'input-picker-pair')
      const button = el('button', 'tile-picker-open', '选牌') as HTMLButtonElement
      button.type = 'button'
      button.addEventListener('click', async () => {
        const value = await openTilePicker(mode, parseTileInput(input.value))
        if (value == null) return
        input.value = value
        input.dispatchEvent(new Event('input', { bubbles: true }))
        publishToOverlay()
      })
      pair.append(input, button)
      return pair
    }

    async function load() {
      if (!gameId) {
        root.innerHTML = '<p class="empty">缺少对局 id（?id=...）</p>'
        return
      }
      const { data: { session } } = await supabase.auth.getSession()
      if (!session) { location.href = base + 'admin/login/'; return }
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single()
      role = profile?.role ?? null
      if (role !== 'admin' && role !== 'referee') { location.href = base + 'admin/'; return }

      const { data: g, error } = await supabase.from('games').select('*').eq('id', gameId).single()
      if (error || !g) {
        root.innerHTML = '<p class="empty">对局不存在</p>'
        showErr(error?.message ?? 'not found')
        return
      }
      if (g.status !== 'upcoming') {
        root.innerHTML = '<p class="empty">该对局不是待比赛程，不能进行直播控制。</p>'
        return
      }
      game = g
      restore()
      render()
    }

    function restore() {
      try {
        const raw = localStorage.getItem(draftStorageKey()) ?? localStorage.getItem(liveStorageKey(gameId!))
        if (!raw) return
        const state = JSON.parse(raw)
        rounds = state.rounds ?? []
        currentDora = state.currentDora ?? []
        currentWaits = state.currentWaits ?? [[], [], [], []]
        if (Array.isArray(state.currentRiichi)) form.riichi = [0, 1, 2, 3].map((i) => Boolean(state.currentRiichi[i]))
        liveOnly = state.liveOnly ?? emptyLiveOnly()
        liveOnly.scoreOverridesByOrder = {}
      } catch {
        rounds = []
      }
    }

    function draftStorageKey() {
      return `${liveStorageKey(gameId!)}:draft`
    }

    function buildLiveState(summary?: { id: string }) {
      return {
        version: 1,
        gameId,
        game,
        rounds,
        currentDora,
        currentWaits,
        currentRiichi: [...form.riichi],
        scoreOverride: null,
        liveOnly,
        ...(summary ? { summary } : {}),
        updatedAt: new Date().toISOString(),
      }
    }

    function saveDraftState() {
      if (!gameId) return
      localStorage.setItem(draftStorageKey(), JSON.stringify(buildLiveState()))
    }

    function publish(summary?: { id: string }) {
      if (!gameId) return
      const state = buildLiveState(summary)
      localStorage.setItem(draftStorageKey(), JSON.stringify(state))
      localStorage.setItem(liveStorageKey(gameId), JSON.stringify(state))
      queueRemotePublish(state)
    }

    function publishToOverlay() {
      if (!game) return
      publish()
      showErr('已放送到直播画面')
    }

    function queueRemotePublish(state: any) {
      if (publishTimer) clearTimeout(publishTimer)
      publishTimer = setTimeout(() => {
        publishTimer = null
        void publishRemote(state)
      }, 120)
    }

    async function publishRemote(state: any) {
      const token = localStorage.getItem(TOKEN_KEY)
      if (!token || !gameId) return
      try {
        const res = await fetch(`${base}api/games/${encodeURIComponent(gameId)}/live-state`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({ state }),
        })
        if (!res.ok) {
          const body = await res.json().catch(() => null)
          showErr('直播源同步失败：' + (body?.error?.message ?? `HTTP ${res.status}`))
        }
      } catch (e: any) {
        showErr('直播源同步失败：' + (e?.message ?? String(e)))
      }
    }

    function render() {
      clearErr()
      const rep = replayGame(rounds)
      const current = stateOf(rep)
      const scores = current.scores
      const dealer = dealerSeat(current.round)
      const overlayUrl = `${location.origin}${base}live-overlay/?id=${encodeURIComponent(gameId!)}`

      root.innerHTML = ''
      const top = el('div', 'live-panel')
      top.appendChild(el('h2', '', `${game.stage} ${game.round ?? ''} · ${roundLabel(current.round)} · 供托 ${current.pool * 1000}`))
      const strip = el('div', 'score-strip')
      ;(game.seats ?? []).forEach((seat: any, i: number) => {
        const card = el('div', 'score-card' + (i === dealer ? ' dealer' : ''))
        card.style.setProperty('--team-color', teams.get(seat.team) ?? '#242a33')
        card.append(
          el('div', 'label', `${seat.seat} ${seat.team} ${seat.player ?? ''}`),
          el('div', 'value', Number(scores[i] ?? 25000).toLocaleString('en-US')),
        )
        strip.appendChild(card)
      })
      top.appendChild(strip)
      const finalPoolNote = finalPoolMessage(rep)
      if (finalPoolNote) top.appendChild(el('p', 'import-hint', finalPoolNote))
      const linkRow = el('p', 'import-hint overlay-link', `直播姬浏览器源：${overlayUrl}`)
      top.appendChild(linkRow)
      root.appendChild(top)

      const grid = el('div', 'live-grid')
      grid.appendChild(renderLivePanel(editingOrder ?? nextOrder()))
      grid.appendChild(renderRoundPanel(rep))
      root.appendChild(grid)
      saveDraftState()
    }

    function stateOf(rep = replayGame(rounds)) {
      return editingOrder != null && editState ? editState : rep.current
    }

    function renderLivePanel(order: number): HTMLElement {
      const panel = el('section', 'live-panel')
      panel.appendChild(el('h2', '', '画面控制'))
      if (editingOrder != null) {
        panel.appendChild(el('p', 'import-hint', `正在${editMode === 'rewind' ? '回退重录' : '修改'}第 ${editingOrder} 局`))
      }

      const doraRow = el('div', 'live-row')
      const doraInputs = el('div', 'dora-inputs')
      const doraPreview = el('div', 'tile-preview')
      const updateDora = () => {
        currentDora = Array.from(doraInputs.querySelectorAll('input'))
          .map((input) => parseTileInput((input as HTMLInputElement).value)[0])
          .filter(Boolean)
        liveOnly.doraByOrder[String(order)] = currentDora
        renderTilePreview(doraPreview, currentDora)
        saveDraftState()
      }
      for (let i = 0; i < 4; i++) {
        const input = document.createElement('input')
        input.type = 'text'
        input.placeholder = `${i + 1}`
        input.value = currentDora[i] ?? ''
        input.maxLength = 3
        input.addEventListener('input', updateDora)
        doraInputs.appendChild(inputPickerPair(input, 'dora'))
      }
      renderTilePreview(doraPreview, currentDora)
      doraRow.append(el('label', '', '宝牌'), doraInputs, doraPreview)
      panel.appendChild(doraRow)

      ;[0, 1, 2, 3].forEach((i) => {
        const row = el('div', 'live-row')
        const input = document.createElement('input')
        input.type = 'text'
        input.placeholder = '听牌，如 36m'
        input.value = currentWaits[i]?.join('') ?? ''
        const preview = el('div', 'tile-preview')
        renderTilePreview(preview, currentWaits[i] ?? [])
        input.addEventListener('input', () => {
          currentWaits[i] = parseTileInput(input.value)
          liveOnly.waitsByOrder[String(order)] = currentWaits
          renderTilePreview(preview, currentWaits[i])
          saveDraftState()
        })
        const seat = game.seats?.[i]
        row.append(el('label', '', `${seat?.seat ?? seatLabel(i)} ${seat?.player ?? ''}`), inputPickerPair(input, 'wait'), preview)
        panel.appendChild(row)
      })

      panel.appendChild(renderInputForm())
      return panel
    }

    function renderRestartPanel(current: { round: RoundState; pool: number; scores: number[] }): HTMLElement {
      const panel = el('section', 'restart-panel')
      panel.appendChild(el('h2', '', '紧急重开'))
      panel.appendChild(el('p', 'import-hint', '用于直播中途从指定局面和点数重新开始；会在已录小局中留下分隔。'))
      const draft = resetDraft ?? {
        wind: current.round.wind,
        number: current.round.number,
        honba: current.round.honba,
        pool: current.pool,
        scores: [...current.scores],
      }
      resetDraft = draft

      const roundRow = el('div', 'live-row')
      const windSelect = document.createElement('select')
      ;(['东', '南'] as RoundState['wind'][]).forEach((wind) => {
        const option = document.createElement('option')
        option.value = wind
        option.textContent = wind
        option.selected = draft.wind === wind
        windSelect.appendChild(option)
      })
      windSelect.addEventListener('change', () => { draft.wind = windSelect.value as RoundState['wind']; saveDraftState() })
      const numberSelect = document.createElement('select')
      ;([1, 2, 3, 4] as RoundState['number'][]).forEach((num) => {
        const option = document.createElement('option')
        option.value = String(num)
        option.textContent = String(num)
        option.selected = draft.number === num
        numberSelect.appendChild(option)
      })
      numberSelect.addEventListener('change', () => { draft.number = Number(numberSelect.value) as RoundState['number']; saveDraftState() })
      const honbaInput = document.createElement('input')
      honbaInput.type = 'number'
      honbaInput.min = '0'
      honbaInput.value = String(draft.honba)
      honbaInput.addEventListener('input', () => { draft.honba = Math.max(0, Number(honbaInput.value) || 0); saveDraftState() })
      const poolInput = document.createElement('input')
      poolInput.type = 'number'
      poolInput.min = '0'
      poolInput.value = String(draft.pool)
      poolInput.addEventListener('input', () => { draft.pool = Math.max(0, Number(poolInput.value) || 0); saveDraftState() })
      roundRow.append(el('strong', '', '局面'), windSelect, numberSelect, el('span', '', '局'), el('span', '', '本场'), honbaInput, el('span', '', '供托'), poolInput)
      panel.appendChild(roundRow)

      const scoreRow = el('div', 'live-row')
      scoreRow.appendChild(el('strong', '', '点数'))
      const scoreInputs: HTMLInputElement[] = []
      for (let i = 0; i < 4; i++) {
        const input = document.createElement('input')
        input.type = 'number'
        input.value = String(draft.scores[i] ?? 25000)
        input.addEventListener('input', () => {
          draft.scores[i] = Number(input.value) || 0
          saveDraftState()
        })
        scoreInputs.push(input)
        scoreRow.appendChild(input)
      }
      panel.appendChild(scoreRow)

      const actions = el('div', 'live-actions')
      const fillBtn = el('button', '', '填入当前')
      fillBtn.addEventListener('click', () => {
        resetDraft = {
          wind: current.round.wind,
          number: current.round.number,
          honba: current.round.honba,
          pool: current.pool,
          scores: [...current.scores],
        }
        render()
      })
      const restartBtn = el('button', 'primary', '重开')
      restartBtn.addEventListener('click', () => restartFromDraft(scoreInputs))
      actions.append(fillBtn, restartBtn)
      panel.appendChild(actions)
      return panel
    }

    function restartFromDraft(scoreInputs: HTMLInputElement[]) {
      if (!resetDraft) return
      const scores = scoreInputs.map((input) => Number(input.value))
      const honba = Number(resetDraft.honba)
      const pool = Number(resetDraft.pool)
      if (scores.some((v) => !Number.isInteger(v))) return showErr('重开点数必须都是整数')
      if (!Number.isInteger(honba) || honba < 0 || !Number.isInteger(pool) || pool < 0) return showErr('本场和供托必须是非负整数')
      const label = roundLabel({ wind: resetDraft.wind, number: resetDraft.number, honba })
      const summary = `${label}，供托 ${pool * 1000}，点数 ${scores.join(' / ')}`
      if (!window.confirm(`确认要紧急重开吗？\n\n${summary}\n\n重开会在已录小局中加入分隔，之后从此状态继续计算。`)) return
      const order = nextOrder()
      rounds.push({
        order,
        reset: {
          round: { wind: resetDraft.wind, number: resetDraft.number, honba },
          scores,
          pool,
          label: `${label} 重开`,
        },
        win_type: null,
        riichi: [false, false, false, false],
        ron_winner: null,
        ron_loser: null,
        ron_points: null,
        tsumo_winner: null,
        tsumo_points: null,
        tenpai: null,
      })
      rounds.sort((a, b) => a.order - b.order)
      currentDora = []
      currentWaits = [[], [], [], []]
      editingOrder = null
      editMode = null
      editState = null
      resetDraft = null
      resetForm()
      publish()
      render()
    }

    function renderInputForm(): HTMLElement {
      const wrap = el('div')
      wrap.appendChild(el('h2', '', '逐局录入'))

      const typeRow = el('div', 'live-row')
      ;(['ron', 'tsumo', 'draw'] as const).forEach((type) => {
        const label = document.createElement('label')
        const radio = document.createElement('input')
        radio.type = 'radio'
        radio.name = 'winType'
        radio.checked = form.winType === type
        radio.addEventListener('change', () => { form.winType = type; render() })
        label.append(radio, document.createTextNode(({ ron: '荣和', tsumo: '自摸', draw: '流局' })[type]))
        typeRow.appendChild(label)
      })
      wrap.appendChild(typeRow)

      if (form.winType === 'ron') {
        wrap.appendChild(renderSeatPicker('赢家', form.winner, (i) => { form.winner = i; render() }))
        wrap.appendChild(renderSeatPicker('放铳', form.loser, (i) => { form.loser = i; render() }))
      } else if (form.winType === 'tsumo') {
        wrap.appendChild(renderSeatPicker('自摸', form.winner, (i) => { form.winner = i; render() }))
      } else if (form.winType === 'draw') {
        const row = el('div', 'live-row')
        row.appendChild(el('strong', '', '流局听牌'))
        for (let i = 0; i < 4; i++) {
          const label = document.createElement('label')
          const cb = document.createElement('input')
          cb.type = 'checkbox'
          cb.checked = form.tenpai[i]
          cb.addEventListener('change', () => { form.tenpai[i] = cb.checked; saveDraftState() })
          label.append(cb, document.createTextNode(game.seats?.[i]?.seat ?? seatLabel(i)))
          row.appendChild(label)
        }
        wrap.appendChild(row)
      }

      const riichiRow = el('div', 'live-row')
      riichiRow.appendChild(el('strong', '', '立直'))
      for (let i = 0; i < 4; i++) {
        const label = document.createElement('label')
        const cb = document.createElement('input')
        cb.type = 'checkbox'
        cb.checked = form.riichi[i]
        cb.addEventListener('change', () => { form.riichi[i] = cb.checked; saveDraftState() })
        label.append(cb, document.createTextNode(game.seats?.[i]?.seat ?? seatLabel(i)))
        riichiRow.appendChild(label)
      }
      wrap.appendChild(riichiRow)

      if (form.winType === 'ron' || form.winType === 'tsumo') wrap.appendChild(renderPointsPicker())

      const actions = el('div', 'live-actions')
      const nextBtn = el('button', 'primary', '保存并下一局')
      nextBtn.addEventListener('click', saveAndNext)
      const publishBtn = el('button', '', '放送')
      publishBtn.addEventListener('click', publishToOverlay)
      const exportBtn = el('button', '', '导出 JSON')
      exportBtn.addEventListener('click', exportJson)
      const clearBtn = el('button', 'danger', '清除全部直播录入')
      clearBtn.addEventListener('click', clearLiveRecords)
      actions.append(nextBtn, publishBtn, exportBtn, clearBtn)
      if (isHanchanComplete(replayGame(rounds))) {
        const summaryBtn = el('button', 'primary', '放送总结')
        summaryBtn.addEventListener('click', () => {
          publish({ id: crypto.randomUUID() })
          showErr('已放送赛后总结到直播画面')
        })
        actions.appendChild(summaryBtn)
      }
      wrap.appendChild(actions)
      return wrap
    }

    function renderSeatPicker(title: string, selected: number | null, onPick: (i: number) => void): HTMLElement {
      const wrap = el('div', 'live-row')
      wrap.appendChild(el('strong', '', title))
      const picks = el('div', 'seat-pick')
      for (let i = 0; i < 4; i++) {
        const seat = game.seats?.[i]
        const btn = el('button', selected === i ? 'sel' : '')
        btn.type = 'button'
        btn.innerHTML = `<span class="seat-name">${seat?.seat ?? seatLabel(i)} ${seat?.player ?? ''}</span><span class="seat-team">${seat?.team ?? ''}</span>`
        btn.addEventListener('click', () => onPick(i))
        picks.appendChild(btn)
      }
      wrap.appendChild(picks)
      return wrap
    }

    function renderPointsPicker(): HTMLElement {
      const wrap = el('div')
      const rep = replayGame(rounds)
      const winner = form.winner
      const view = winner != null && winner === dealerSeat(stateOf(rep).round) ? 'dealer' : 'child'
      const isRon = form.winType === 'ron'
      const grid = el('div', 'points-grid')
      const table = el('table')
      const thead = el('thead')
      const hr = el('tr')
      hr.appendChild(el('th'))
      FU.forEach((f) => hr.appendChild(el('th', '', `${f}符`)))
      thead.appendChild(hr)
      table.appendChild(thead)
      const tbody = el('tbody')
      HAN.forEach((han) => {
        const tr = el('tr')
        tr.appendChild(el('th', '', `${han}番`))
        FU.forEach((fu) => {
          const td = el('td')
          if (!(isRon && fu === '20')) {
            const cell = points.grid[view][han]?.[fu]
            if (cell) {
              const btn = el('button', 'point-btn', isRon ? String(cell.ron) : cell.tsumo.join('/')) as HTMLButtonElement
              const key = `cell:${view}:${han}:${fu}`
              if (form.selKey === key) btn.classList.add('sel')
              btn.addEventListener('click', () => {
                form.selKey = key
                if (isRon) {
                  form.ronPoints = cell.ron
                  form.tsumoSplit = null
                } else {
                  form.tsumoSplit = [...cell.tsumo]
                  form.ronPoints = null
                }
                render()
              })
              td.appendChild(btn)
            }
          }
          tr.appendChild(td)
        })
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      grid.appendChild(table)
      wrap.appendChild(grid)

      const tiers = el('div', 'tier-row')
      points.tiers.forEach((tier) => {
        const val = view === 'dealer'
          ? (isRon ? tier.dealerRon : tier.dealerTsumo[0])
          : (isRon ? tier.childRon : `${tier.childTsumo[0]}/${tier.childTsumo[1]}`)
        const btn = el('button', 'tier-btn', `${tier.label} ${val}`) as HTMLButtonElement
        const key = `tier:${tier.key}`
        if (form.selKey === key) btn.classList.add('sel')
        btn.addEventListener('click', () => {
          form.selKey = key
          if (isRon) {
            form.ronPoints = view === 'dealer' ? tier.dealerRon : tier.childRon
            form.tsumoSplit = null
          } else {
            form.tsumoSplit = view === 'dealer' ? [...tier.dealerTsumo] : [...tier.childTsumo]
            form.ronPoints = null
          }
          render()
        })
        tiers.appendChild(btn)
      })
      wrap.appendChild(tiers)

      const manual = el('div', 'live-row')
      manual.appendChild(el('strong', '', '手动'))
      if (isRon) {
        const input = document.createElement('input')
        input.type = 'number'
        input.placeholder = '荣和点'
        input.value = form.ronPoints != null ? String(form.ronPoints) : ''
        input.addEventListener('change', () => {
          form.ronPoints = Number(input.value) || null
          form.tsumoSplit = null
          form.selKey = null
          render()
        })
        manual.appendChild(input)
      } else {
        const parts = view === 'dealer' ? 1 : 2
        const inputs: HTMLInputElement[] = []
        for (let i = 0; i < parts; i++) {
          const input = document.createElement('input')
          input.type = 'number'
          input.placeholder = view === 'dealer' ? '各付' : i === 0 ? '子付' : '亲付'
          input.value = form.tsumoSplit?.[i] != null ? String(form.tsumoSplit[i]) : ''
          inputs.push(input)
          manual.appendChild(input)
        }
        const apply = el('button', '', '确认')
        apply.addEventListener('click', () => {
          const vals = inputs.map((input) => Number(input.value))
          if (vals.some((x) => !x || x <= 0 || x % 100 !== 0)) return showErr('手动点数须为正的 100 倍数')
          form.tsumoSplit = vals
          form.ronPoints = null
          form.selKey = null
          render()
        })
        manual.appendChild(apply)
      }
      wrap.appendChild(manual)
      return wrap
    }

    function buildResult(): RoundResult | null {
      const riichi = [...form.riichi]
      if (form.winType === 'ron') {
        if (form.winner == null || form.loser == null || !form.ronPoints || form.winner === form.loser) return null
        return { winType: 'ron', riichi, winner: form.winner, loser: form.loser, ronPoints: form.ronPoints }
      }
      if (form.winType === 'tsumo') {
        if (form.winner == null || !form.tsumoSplit) return null
        const rep = replayGame(rounds)
        const dealer = dealerSeat(stateOf(rep).round)
        const pays = [0, 0, 0, 0]
        if (form.tsumoSplit.length === 1) {
          for (let i = 0; i < 4; i++) if (i !== form.winner) pays[i] = form.tsumoSplit[0]
        } else {
          for (let i = 0; i < 4; i++) if (i !== form.winner) pays[i] = i === dealer ? form.tsumoSplit![1] : form.tsumoSplit![0]
        }
        return { winType: 'tsumo', riichi, winner: form.winner, tsumoPayments: pays }
      }
      if (form.winType === 'draw') return { winType: 'draw', riichi, tenpai: [...form.tenpai] }
      return null
    }

    function saveAndNext() {
      const result = buildResult()
      if (!result) return showErr('请补全本局结果')
      const rep = replayGame(rounds)
      const st = stateOf(rep)
      const order = editingOrder ?? nextOrder()
      const settled = settleRound(st.round, result, st.pool)
      if (settled.deltas.reduce((a, b) => a + b, 0) + (settled.poolAfter - st.pool) * 1000 !== 0) {
        return showErr('点数不平衡，请检查录入')
      }
      const payload: StoredRound = {
        order,
        win_type: form.winType,
        riichi: [...form.riichi],
        ron_winner: form.winType === 'ron' ? seatLabel(form.winner!) : null,
        ron_loser: form.winType === 'ron' ? seatLabel(form.loser!) : null,
        ron_points: form.winType === 'ron' ? form.ronPoints : null,
        tsumo_winner: form.winType === 'tsumo' ? seatLabel(form.winner!) : null,
        tsumo_points: form.winType === 'tsumo' ? form.tsumoSplit : null,
        tenpai: form.winType === 'draw' ? [...form.tenpai] : null,
        override: undefined,
      }
      if (editingOrder != null && editMode === 'edit') {
        const incompatibility = editIncompatibility(order, payload)
        if (incompatibility) return showErr(incompatibility)
      }
      const existing = rounds.findIndex((round) => round.order === order)
      if (existing >= 0) rounds[existing] = payload
      else rounds.push(payload)
      if (editingOrder != null && editMode === 'rewind') {
        cutCurrentSegmentAfter(order)
      }
      rounds.sort((a, b) => a.order - b.order)
      liveOnly.doraByOrder[String(order)] = currentDora
      liveOnly.waitsByOrder[String(order)] = currentWaits
      currentDora = []
      currentWaits = [[], [], [], []]
      editingOrder = null
      editMode = null
      editState = null
      resetForm()
      const next = nextRound(st.round, result)
      publish()
      render()
      if (!next) showErr(finalPoolMessage(replayGame(rounds)) || '南四非连庄结果已录完，可以导出 JSON 并导入官网。')
    }

    function editIncompatibility(order: number, replacement: StoredRound): string {
      const nextResetOrder = rounds
        .filter((round) => round.order > order && round.reset)
        .sort((a, b) => a.order - b.order)[0]?.order ?? Infinity
      const followingOrders = rounds
        .filter((round) => round.order > order && round.order < nextResetOrder && !round.reset && round.win_type)
        .map((round) => round.order)
      if (!followingOrders.length) return ''

      const changedRounds = rounds.map((round) => round.order === order ? replacement : round)
      const originalHistory = new Map(replayGame(rounds).history.map((round) => [round.order, round]))
      const changedHistory = new Map(replayGame(changedRounds).history.map((round) => [round.order, round]))
      for (const followingOrder of followingOrders) {
        const original = originalHistory.get(followingOrder)
        const changed = changedHistory.get(followingOrder)
        if (!original || !changed) {
          return `不允许保存：这项修改会让后续已录的小局提前失效。请使用“回退”后重录。`
        }
        if (
          original.round.wind !== changed.round.wind ||
          original.round.number !== changed.round.number ||
          original.round.honba !== changed.round.honba
        ) {
          return `不允许保存：修改后第 ${followingOrder} 局会从${roundLabel(original.round)}变为${roundLabel(changed.round)}，与后续记录不兼容（含连庄/本场变化）。请使用“回退”后重录。`
        }
      }
      return ''
    }

    function resetForm() {
      form.winType = null
      form.riichi = [false, false, false, false]
      form.winner = null
      form.loser = null
      form.ronPoints = null
      form.tsumoSplit = null
      form.tenpai = [false, false, false, false]
      form.selKey = null
    }

    function clearLiveRecords() {
      if (!window.confirm('确认清除本半庄的全部直播录入吗？\n\n这会清空已录小局、宝牌、听牌和草稿，并同步清空直播源；已导出的 JSON 不受影响。')) return
      rounds = []
      currentDora = []
      currentWaits = [[], [], [], []]
      liveOnly = emptyLiveOnly()
      editingOrder = null
      editMode = null
      editState = null
      resetDraft = null
      resetForm()
      publish()
      render()
      showErr('已清除全部直播录入记录，并同步到直播画面')
    }

    function renderRoundPanel(rep: ReturnType<typeof replayGame>): HTMLElement {
      const panel = el('section', 'live-panel')
      panel.appendChild(el('h2', '', '已录小局'))
      const list = el('div', 'round-list')
      const table = el('table')
      table.innerHTML = '<thead><tr><th>序</th><th>局</th><th>结果</th><th>分数</th><th>操作</th></tr></thead>'
      const tbody = el('tbody')
      const historyByOrder = new Map(rep.history.map((h) => [h.order, h]))
      ;[...rounds].sort((a, b) => a.order - b.order).forEach((round) => {
        if (round.reset) {
          const tr = el('tr', 'round-reset-row')
          const td = el('td', '', `从 ${round.reset.label ?? roundLabel(round.reset.round)} 重新开始：供托 ${round.reset.pool * 1000}，点数 ${round.reset.scores.join(' / ')}`)
          td.colSpan = 5
          tr.appendChild(td)
          tbody.appendChild(tr)
          return
        }
        const h = historyByOrder.get(round.order)
        if (!h) return
        const tr = el('tr')
        const ops = el('td')
        const editBtn = el('button', '', '改')
        editBtn.addEventListener('click', () => {
          if (window.confirm(`确认修改第 ${h.order} 局吗？`)) openEdit(h.order, 'edit')
        })
        const rewindBtn = el('button', '', '回退')
        rewindBtn.style.marginLeft = '6px'
        rewindBtn.addEventListener('click', () => {
          if (window.confirm(`确认回退到第 ${h.order} 局并重录吗？\n\n之后的小局会在重新保存时被移除。`)) openEdit(h.order, 'rewind')
        })
        ops.append(editBtn, rewindBtn)
        tr.append(
          el('td', '', String(h.order)),
          el('td', '', roundLabel(h.round)),
          el('td', '', resultText(h.result)),
          el('td', '', h.scores.map((s) => String(s)).join(' / ')),
          ops,
        )
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      list.appendChild(table)
      panel.appendChild(list)
      panel.appendChild(renderRestartPanel(rep.current))
      return panel
    }

    function openEdit(order: number, mode: 'edit' | 'rewind') {
      const stored = rounds.find((round) => round.order === order)
      if (!stored || stored.reset || !stored.win_type) return
      const before = replayGame(rounds.filter((round) => round.order < order)).current
      editingOrder = order
      editMode = mode
      editState = {
        round: before.round,
        pool: before.pool,
        scores: [...before.scores],
      }
      currentDora = [...(liveOnly.doraByOrder[String(order)] ?? [])]
      currentWaits = (liveOnly.waitsByOrder[String(order)] ?? [[], [], [], []]).map((tiles) => [...tiles])
      form.winType = stored.win_type
      form.riichi = [...(stored.riichi ?? [false, false, false, false])]
      form.winner = null
      form.loser = null
      form.ronPoints = null
      form.tsumoSplit = null
      form.tenpai = [false, false, false, false]
      if (stored.win_type === 'ron') {
        form.winner = seatIndexOfSafe(stored.ron_winner)
        form.loser = seatIndexOfSafe(stored.ron_loser)
        form.ronPoints = stored.ron_points
      } else if (stored.win_type === 'tsumo') {
        form.winner = seatIndexOfSafe(stored.tsumo_winner)
        form.tsumoSplit = stored.tsumo_points ? [...stored.tsumo_points] : null
      } else {
        form.tenpai = stored.tenpai ? [...stored.tenpai] : [false, false, false, false]
      }
      form.selKey = null
      render()
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }

    function seatIndexOfSafe(seat: string | null): number | null {
      if (seat == null) return null
      const idx = [0, 1, 2, 3].map(seatLabel).indexOf(seat)
      return idx >= 0 ? idx : null
    }

    function nextOrder(): number {
      return Math.max(0, ...rounds.map((round) => Number(round.order) || 0)) + 1
    }

    function cutCurrentSegmentAfter(order: number) {
      const nextReset = [...rounds]
        .filter((round) => round.order > order && round.reset)
        .sort((a, b) => a.order - b.order)[0]?.order
      rounds = rounds.filter((round) => round.order <= order || (nextReset != null && round.order >= nextReset))
    }

    function resultText(result: RoundResult): string {
      if (result.winType === 'ron') return `${seatLabel(result.winner!)}荣和${seatLabel(result.loser!)}`
      if (result.winType === 'tsumo') return `${seatLabel(result.winner!)}自摸`
      return `流局(${(result.tenpai ?? []).filter(Boolean).length}听)`
    }

    function isHanchanComplete(rep: ReturnType<typeof replayGame>): boolean {
      const latest = rep.history[rep.history.length - 1]
      return Boolean(latest && nextRound(latest.round, latest.result) == null)
    }

    function finalPoolMessage(rep: ReturnType<typeof replayGame>): string {
      const settlement = rep.finalPool
      if (!settlement) return ''
      if (settlement.requiresManual) {
        return `终局剩余供托 ${settlement.amount} 点：三家并列第一，未自动分配。请在逐局录入的赛果页手动处理最终分数。`
      }
      const seats = settlement.recipients.map((i) => game.seats?.[i]?.player ?? game.seats?.[i]?.seat ?? seatLabel(i)).join('、')
      return `终局剩余供托 ${settlement.amount} 点已分配给第一名：${seats}。`
    }

    function renderTilePreview(root: HTMLElement, codes: string[]) {
      root.innerHTML = ''
      for (const code of codes) {
        const img = document.createElement('img')
        img.src = tileImageSrc(code)
        img.alt = tileLabel(code)
        root.appendChild(img)
      }
    }

    function exportJson() {
      const payload = {
        version: 1,
        gameId,
        exportedAt: new Date().toISOString(),
        rounds,
        liveOnly,
      }
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' })
      const url = URL.createObjectURL(blob)
      const a = document.createElement('a')
      a.href = url
      a.download = `pkuml-live-${gameId}.json`
      a.click()
      URL.revokeObjectURL(url)
    }

    document.addEventListener('keydown', (event) => {
      if (
        event.key !== 'Enter' ||
        event.repeat ||
        event.isComposing ||
        event.ctrlKey ||
        event.altKey ||
        event.metaKey ||
        document.querySelector('.tile-picker-backdrop')
      ) return
      event.preventDefault()
      publishToOverlay()
    })

    load()
  </script>
</BaseLayout>
