---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import AdminShell from '../../../../components/admin/AdminShell.astro'
---
<BaseLayout title="查看结果">
  <AdminShell>
    <h1>查看结果</h1>
    <p id="res-err" class="admin-err"></p>
    <div id="res-root">
      <p class="empty">加载中…</p>
    </div>
  </AdminShell>
  <style is:global>
    .res-table input { width: 90px; text-align: right; font-variant-numeric: tabular-nums; font-size: 18px; padding: 4px 6px; }
    .res-table select { font-size: 16px; padding: 4px 6px; }
    .res-table { font-size: 15px; }
    /* 两个表格居中 */
    .res-table-wrap { max-width: 85%; margin: 0 auto; }
    .res-sum { font-size: 15px; margin: 10px 0; text-align: center; }
    .res-sum.bad { color: #b91c1c; font-weight: 700; }
    .res-stages { margin: 18px auto 0; max-width: 95%; }
    .res-stages h3 { font-size: 18px; }
    .res-stages input { width: 84px; font-size: 15px; padding: 3px 6px; text-align: right; font-variant-numeric: tabular-nums; }
    .res-stages input[type='text'] { width: 140px; text-align: left; }
    .res-actions { display: flex; gap: 10px; margin: 14px 0; justify-content: center; }
    .res-actions button { padding: 10px 22px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 18px; }
    .res-actions button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .res-stages button { padding: 6px 14px; border-radius: 6px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 16px; }
    .res-stages button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  </style>
  <script>
    import { supabase } from '../../../../lib/supabase'
    import { replayGame, roundLabel, seatLabel, riichiText, parseRiichi } from '../../../../lib/replay'
    import { rawScoreOf, rankPointsForScores, competitionRanks } from '../../../../lib/aggregate'
    import type { RoundResult } from '../../../../lib/scoring'

    const base = import.meta.env.BASE_URL
    const errEl = document.getElementById('res-err')!
    const root = document.getElementById('res-root')!
    const showErr = (m: string) => { errEl.textContent = m }
    const clearErr = () => { errEl.textContent = '' }

    const params = new URLSearchParams(location.search)
    const gameId = params.get('id')
    if (!gameId) {
      root.innerHTML = '<p class="empty">缺少对局 id（?id=…）</p>'
    }

    function el(tag: string, cls = '', text = ''): HTMLElement {
      const n = document.createElement(tag)
      if (cls) n.className = cls
      if (text) n.textContent = text
      return n
    }

    let game: any = null
    let role: string | null = null
    let rep: ReturnType<typeof replayGame> | null = null
    let finalScores: number[] = []
    let scoreInputs: HTMLInputElement[] = []
    let ptInputs: HTMLInputElement[] = []
    let rpInputs: HTMLInputElement[] = []
    let rankSelects: HTMLSelectElement[] = []
    let penInputs: HTMLInputElement[] = []
    // 阶段表行编辑引用
    let roundEdits: { order: number; roundLabelInput: HTMLInputElement; resultInput: HTMLInputElement; pointsInput: HTMLInputElement; poolInput: HTMLInputElement; deltaInputs: HTMLInputElement[] }[] = []

    async function loadRounds(): Promise<any[]> {
      const { data } = await supabase.from('rounds').select('*').eq('game_id', gameId).order('order', { ascending: true })
      return (data ?? []).map((r: any) => ({
        order: r.order,
        win_type: r.win_type,
        riichi: r.riichi ?? [false, false, false, false],
        ron_winner: r.ron_winner,
        ron_loser: r.ron_loser,
        ron_points: r.ron_points,
        tsumo_winner: r.tsumo_winner,
        tsumo_points: r.tsumo_points,
        tenpai: r.tenpai,
        override: r.override,
      }))
    }

    async function load() {
      if (!gameId) return
      const { data: { session } } = await supabase.auth.getSession()
      if (!session) { location.href = base + 'admin/login/'; return }
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single()
      role = profile?.role ?? null
      if (role !== 'admin' && role !== 'referee') { location.href = base + 'admin/'; return }

      const { data: g, error } = await supabase.from('games').select('*').eq('id', gameId).single()
      if (error || !g) { showErr('加载对局失败：' + (error?.message ?? 'not found')); root.innerHTML = '<p class="empty">对局不存在。</p>'; return }
      game = g
      if (g.status === 'finished') {
        if (role === 'admin') {
          // 管理员可修改已提交赛果并重新提交（总表以已存 seats 为准）
          const rounds = await loadRounds()
          rep = replayGame(rounds)
          const seats = game.seats ?? []
          finalScores = seats.map((s: any) => s.points ?? 25000)
          renderAll(true)
        } else {
          root.innerHTML = ''
          root.appendChild(el('p', 'sel-info', '该半庄已提交为赛果（裁判不可修改，仅管理员可改）。'))
          const link = el('a', '', '查看赛果详情')
          link.href = base + 'match/?id=' + encodeURIComponent(gameId)
          root.appendChild(link)
        }
        return
      }
      render()
    }

    function render() {
      clearErr()
      root.innerHTML = ''
      ;(async () => {
        const rounds = await loadRounds()
        rep = replayGame(rounds)
        finalScores = [...rep.current.scores]
        renderAll(false)
      })()
    }

    // ---------- 总表 ----------
    function renderAll(fromSeats: boolean) {
      clearErr()
      root.innerHTML = ''
      const seats = game.seats ?? []
      if (rep?.finalPool?.requiresManual) {
        const note = el('p', 'sel-info', `终局剩余供托 ${rep.finalPool.amount} 点：三家并列第一，系统未自动分配。请在下方「最终分数（可改）」中手动处理后再提交。`)
        note.style.color = '#b45309'
        note.style.fontWeight = '700'
        root.appendChild(note)
      } else if (rep?.finalPool) {
        root.appendChild(el('p', 'sel-info', `终局剩余供托 ${rep.finalPool.amount} 点已自动分配给并列第一名。`))
      }
      scoreInputs = []
      ptInputs = []
      rankSelects = []
      penInputs = []
      roundEdits = []

      const scoreArr = [...finalScores]
      const autoRp = rankPointsForScores(scoreArr)
      const autoPt = scoreArr.map((v, i) => Math.round((rawScoreOf(v) + autoRp[i]) * 10) / 10)
      const autoRanks = competitionRanks(scoreArr)

      // 总表
      const box = el('div', 'table-wrap res-table-wrap')
      const table = el('table')
      table.className = 'res-table'
      const thead = el('thead')
      const htr = el('tr')
      ;['座位', '队伍', '选手', '最终分数(可改)', '素点', '顺位点(可改)', 'pt(可改)', '位次(可改)', '判罚(可改)'].forEach((h) => htr.appendChild(el('th', '', h)))
      thead.appendChild(htr)
      table.appendChild(thead)
      const tbody = el('tbody')

      const sumScoreEl = el('p', 'res-sum', '')
      const sumPtEl = el('p', 'res-sum', '')

      // 分数/顺位点/pt 联动：最终分数为准——改任意一家最终分数，全表 顺位点/pt/位次 自动重算
      // （重算后仍可对某一家手动改 顺位点/pt/位次 处理特殊分 pt）
      function applyAuto() {
        const scores = scoreInputs.map((x) => Number(x.value))
        const autoRp = rankPointsForScores(scores)
        const autoRanks = competitionRanks(scores)
        scoreInputs.forEach((_, i) => {
          const raw = rawScoreOf(scores[i])
          const rp = autoRp[i]
          rpInputs[i].value = String(rp)
          ptInputs[i].value = String(Math.round((raw + rp) * 10) / 10)
          rankSelects[i].value = String(autoRanks[i])
        })
        refresh()
      }
      function refreshFromRp(i: number) {
        const raw = rawScoreOf(Number(scoreInputs[i].value) || 0)
        const rp = Number(rpInputs[i].value)
        const pt = Math.round((raw + (Number.isFinite(rp) ? rp : 0)) * 10) / 10
        ptInputs[i].value = String(pt)
        refresh()
      }
      function refreshFromPt(i: number) {
        const raw = rawScoreOf(Number(scoreInputs[i].value) || 0)
        const pt = Number(ptInputs[i].value)
        const rp = Math.round(((Number.isFinite(pt) ? pt : 0) - raw) * 10) / 10
        rpInputs[i].value = String(rp)
        refresh()
      }
      function refresh() {
        const scores = scoreInputs.map((x) => Number(x.value))
        const pts = ptInputs.map((x) => Number(x.value))
        const rows = tbody.querySelectorAll('tr')
        rows.forEach((tr, i) => {
          const tds = tr.querySelectorAll('td')
          tds[4].textContent = String(rawScoreOf(scores[i]))
        })
        const sSum = scores.reduce((a, b) => a + (Number.isFinite(b) ? b : 0), 0)
        sumScoreEl.textContent = `最终分数合计：${sSum}（须为 100000）`
        sumScoreEl.classList.toggle('bad', sSum !== 100000)
        const rawPts = pts.reduce((a, b) => a + (Number.isFinite(b) ? b : 0), 0)
        const pSum = Math.round(rawPts * 10) / 10 // 去除二进制浮点噪声（如 7e-15）
        sumPtEl.textContent = `pt 合计：${pSum}（自动结算通常为 0；判罚另计）`
        sumPtEl.classList.toggle('bad', Math.abs(rawPts) > 0.001)
      }

      // 初始 pt 与顺位点
      const initPt = seats.map((s: any, i: number) => (fromSeats && s.pt != null ? s.pt : autoPt[i]))

      seats.forEach((s: any, i: number) => {
        const tr = el('tr')
        tr.appendChild(el('td', '', s.seat))
        tr.appendChild(el('td', '', s.team))
        tr.appendChild(el('td', '', s.player ?? ''))
        const tdScore = el('td')
        const scoreInput = document.createElement('input')
        scoreInput.type = 'number'
        scoreInput.value = String(scoreArr[i])
        scoreInput.addEventListener('input', applyAuto)
        scoreInputs.push(scoreInput)
        tdScore.appendChild(scoreInput)
        tr.appendChild(tdScore)
        tr.appendChild(el('td', 'num', ''))
        const tdRp = el('td')
        const rpInput = document.createElement('input')
        rpInput.type = 'number'
        rpInput.step = '0.1'
        rpInput.value = String(Math.round((initPt[i] - rawScoreOf(scoreArr[i])) * 10) / 10)
        rpInput.addEventListener('input', () => refreshFromRp(i))
        rpInputs.push(rpInput)
        tdRp.appendChild(rpInput)
        tr.appendChild(tdRp)
        const tdPt = el('td')
        const ptInput = document.createElement('input')
        ptInput.type = 'number'
        ptInput.step = '0.1'
        ptInput.value = String(initPt[i])
        ptInput.addEventListener('input', () => refreshFromPt(i))
        ptInputs.push(ptInput)
        tdPt.appendChild(ptInput)
        tr.appendChild(tdPt)
        const tdRank = el('td')
        const rankSel = document.createElement('select')
        for (let r = 1; r <= 4; r++) {
          const opt = document.createElement('option')
          opt.value = String(r)
          opt.textContent = r + '位'
          rankSel.appendChild(opt)
        }
        rankSel.value = String(fromSeats && s.rank != null ? s.rank : autoRanks[i])
        rankSelects.push(rankSel)
        tdRank.appendChild(rankSel)
        tr.appendChild(tdRank)
        const tdPen = el('td')
        const penInput = document.createElement('input')
        penInput.type = 'number'
        penInput.step = '0.1'
        penInput.value = String(fromSeats && s.penalty != null ? s.penalty : 0)
        penInputs.push(penInput)
        tdPen.appendChild(penInput)
        tr.appendChild(tdPen)
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      box.appendChild(table)
      root.appendChild(box)
      root.appendChild(sumScoreEl)
      root.appendChild(sumPtEl)

      renderActions()
      renderRoundsTable()
      refresh()
    }

    // ---------- 阶段对局表（每格可改 + 任意位置插入 + 局名/立直家可改） ----------
    function renderRoundsTable() {
      if (!rep) return
      // 未录小局：简捷模式——直接按最终分数提交（逐局录入仍可通过「返回录入」进入）
      if (rep.history.length === 0) {
        const hint = el('div', 'table-wrap res-stages')
        hint.appendChild(el('p', 'sel-info', '本场未录入小局：直接填写上方「最终分数」即可提交，pt/位次自动计算；需要逐局录入请点「返回录入」。'))
        root.appendChild(hint)
        return
      }
      const box = el('div', 'table-wrap res-stages')
      box.appendChild(el('h3', '', '阶段对局表（管理员可修改每一格：局/立直家/结果/打点/供托/四家增减；点「＋」在任意两行间插入一行）'))
      const table = el('table')
      const thead = el('thead')
      const htr = el('tr')
      ;['局', '立直家', '结果', '打点', '供托', '东', '南', '西', '北', ''].forEach((h) => htr.appendChild(el('th', '', h)))
      thead.appendChild(htr)
      table.appendChild(thead)
      const tbody = el('tbody')
      const wrapTd = (node: HTMLElement) => { const td = el('td'); td.appendChild(node); return td }

      rep.history.forEach((h) => {
        const tr = el('tr')
        const roundLabelInput = document.createElement('input')
        roundLabelInput.type = 'text'
        roundLabelInput.value = h.override?.roundLabel ?? roundLabel(h.round)
        const riichiInput = document.createElement('input')
        riichiInput.type = 'text'
        riichiInput.placeholder = '东/东西/…'
        riichiInput.value = riichiText(h.result.riichi)
        const resultInput = document.createElement('input')
        resultInput.type = 'text'
        resultInput.value = h.override?.result ?? resultText(h.result)
        const pointsInput = document.createElement('input')
        pointsInput.type = 'number'
        pointsInput.value = String(h.override?.points ?? pointsNum(h.result))
        const poolInput = document.createElement('input')
        poolInput.type = 'number'
        poolInput.value = String(h.pool)
        const deltaInputs = [0, 1, 2, 3].map((i) => {
          const inp = document.createElement('input')
          inp.type = 'number'
          inp.style.width = '126px' // 东南西北修改框加长 50%
          inp.value = String(h.deltas[i])
          return inp
        })
        tr.appendChild(wrapTd(roundLabelInput))
        tr.appendChild(wrapTd(riichiInput))
        tr.appendChild(wrapTd(resultInput))
        tr.appendChild(wrapTd(pointsInput))
        tr.appendChild(wrapTd(poolInput))
        deltaInputs.forEach((di) => tr.appendChild(wrapTd(di)))
        const insertBtn = document.createElement('button')
        insertBtn.type = 'button'
        insertBtn.textContent = '＋'
        insertBtn.title = '在此行后插入一行'
        insertBtn.addEventListener('click', () => insertAfter(h.order))
        tr.appendChild(wrapTd(insertBtn))
        roundEdits.push({ order: h.order, roundLabelInput, riichiInput, resultInput, pointsInput, poolInput, deltaInputs })
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      box.appendChild(table)
      const saveBtn = el('button', 'primary', '保存阶段表修改')
      saveBtn.addEventListener('click', saveRoundsOverrides)
      box.appendChild(saveBtn)
      root.appendChild(box)
    }

    // 在指定小局后插入一行：其后所有局 order +1，新行默认「流局·无人听、增减 0」，由管理员再编辑
    async function insertAfter(order: number) {
      if (!gameId) return
      clearErr()
      const { data: later } = await supabase
        .from('rounds').select('id, "order"').eq('game_id', gameId).gt('"order"', order).order('"order"', { ascending: false })
      for (const r of later ?? []) {
        const { error } = await supabase.from('rounds').update({ order: r.order + 1 }).eq('id', r.id)
        if (error) { showErr('插入失败（重排）' + error.message); return }
      }
      const { error } = await supabase.from('rounds').insert([{
        game_id: gameId,
        order: order + 1,
        win_type: 'draw',
        riichi: [false, false, false, false],
        tenpai: [false, false, false, false],
      }])
      if (error) { showErr('插入失败：' + error.message); return }
      const rounds = await loadRounds()
      rep = replayGame(rounds)
      if (game.status !== 'finished') finalScores = [...rep.current.scores]
      renderAll(game.status === 'finished')
    }

    async function persistRoundsOverrides(): Promise<boolean> {
      if (!gameId) return false
      for (const e of roundEdits) {
        const deltas = e.deltaInputs.map((x) => Number(x.value))
        if (deltas.some((x) => !Number.isFinite(x))) { showErr('第' + e.order + '局四家增减须为数字'); return false }
        const override: Record<string, unknown> = { deltas }
        if (e.roundLabelInput.value.trim()) override.roundLabel = e.roundLabelInput.value.trim()
        if (e.resultInput.value.trim()) override.result = e.resultInput.value.trim()
        if (e.pointsInput.value !== '') override.points = Number(e.pointsInput.value)
        if (e.poolInput.value !== '') override.pool = Number(e.poolInput.value)
        // 立直家：直接写回 rounds.riichi（影响供托重算）
        const riichi = parseRiichi(e.riichiInput.value)
        const { error } = await supabase.from('rounds').upsert({ game_id: gameId, order: e.order, override, riichi }, { onConflict: 'game_id,order' })
        if (error) { showErr('保存失败：' + error.message); return false }
      }
      return true
    }

    async function saveRoundsOverrides() {
      const ok = await persistRoundsOverrides()
      if (!ok) return
      // 回放重算（总表最终分数默认值随增减覆盖联动）
      const rounds = await loadRounds()
      rep = replayGame(rounds)
      if (game.status !== 'finished') finalScores = [...rep.current.scores]
      renderAll(game.status === 'finished')
      showErr('阶段表修改已保存。')
    }

    function renderActions() {
      const actions = el('div', 'res-actions')
      const backBtn = el('button', '', '返回赛程')
      backBtn.addEventListener('click', () => {
        location.href = base + 'admin/schedule/'
      })
      const submitBtn = el('button', 'primary', game.status === 'finished' ? '修改并重新提交' : '提交为赛果')
      submitBtn.addEventListener('click', () => submit(submitBtn))
      actions.append(backBtn)
      if (game.status !== 'finished') {
        const roundBtn = el('button', '', '逐局录入')
        roundBtn.addEventListener('click', () => {
          location.href = base + 'admin/match/?id=' + encodeURIComponent(gameId!)
        })
        actions.append(roundBtn)
      } else if (role === 'admin') {
        const roundBtn = el('button', '', '逐局补录')
        roundBtn.addEventListener('click', () => {
          location.href = base + 'admin/match/?id=' + encodeURIComponent(gameId!)
        })
        actions.append(roundBtn)
      }
      actions.append(submitBtn)
      root.appendChild(actions)
    }

    async function submit(btn: HTMLButtonElement) {
      if (!gameId) return
      clearErr()
      // 1. 静默保存阶段表修改（不重渲染，避免清掉总表正在编辑的值）
      const saved = await persistRoundsOverrides()
      if (!saved) return
      // 2. 总表数据
      const scores = scoreInputs.map((x) => Number(x.value))
      const pts = ptInputs.map((x) => Number(x.value))
      const pens = penInputs.map((x) => Number(x.value))
      const ranks = rankSelects.map((x) => Number(x.value))
      if (scores.some((x) => !Number.isInteger(x))) { showErr('最终分数须为整数'); return }
      if (scores.reduce((a, b) => a + b, 0) !== 100000) { showErr('最终分数合计须为 100000'); return }
      if (pts.some((x) => !Number.isFinite(x)) || pens.some((x) => !Number.isFinite(x))) { showErr('pt 与判罚须为数字'); return }
      // 弃置未完成草稿（比赛按已录小局结算）
      await supabase.from('rounds').delete().eq('game_id', gameId).is('win_type', null)
      const seats = (game.seats ?? []).map((s: any, i: number) => ({
        seat: s.seat,
        team: s.team,
        player: s.player,
        rank: ranks[i],
        points: scores[i],
        pt: pts[i],
        penalty: pens[i],
      }))
      btn.disabled = true
      btn.textContent = '提交中…'
      if (game.status === 'finished') {
        const u = await supabase.rpc('unfinish_game', { p_game_id: gameId })
        if (u.error) { showErr('退回失败：' + u.error.message); btn.disabled = false; btn.textContent = '修改并重新提交'; return }
      }
      const { error } = await supabase.rpc('finish_game', { p_game_id: gameId, p_seats: seats })
      if (error) { showErr('提交失败：' + error.message); btn.disabled = false; btn.textContent = game.status === 'finished' ? '修改并重新提交' : '提交为赛果'; return }
      location.href = base + 'admin/schedule/'
    }

    function resultText(r: RoundResult): string {
      if (r.winType === 'ron') return `${seatLabel(r.winner!)}荣和${seatLabel(r.loser!)}`
      if (r.winType === 'tsumo') return `${seatLabel(r.winner!)}自摸`
      if (r.winType === 'draw') {
        const n = (r.tenpai ?? []).filter(Boolean).length
        return n === 0 ? '流局(无人听)' : `流局(听牌${n})`
      }
      return '?'
    }

    function pointsNum(r: RoundResult): number | null {
      if (r.winType === 'ron') return r.ronPoints ?? null
      if (r.winType === 'tsumo') {
        const pays = (r.tsumoPayments ?? []).filter((x) => x > 0)
        return pays.reduce((a, b) => a + b, 0) || null
      }
      return null
    }

    load()
  </script>
</BaseLayout>
