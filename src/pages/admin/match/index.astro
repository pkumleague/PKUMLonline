---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import AdminShell from '../../../components/admin/AdminShell.astro'
---
<BaseLayout title="对局录入">
  <AdminShell>
    <h1>对局录入</h1>
    <p id="match-err" class="admin-err"></p>
    <div id="match-root" class="match-root">
      <p class="empty">加载中…</p>
    </div>
  </AdminShell>
  <style is:global>
    .match-root { min-width: 0; }
    /* 勾选与按键约缩到之前的 1/2 */
    input[type='checkbox'], input[type='radio'] { transform: scale(2); margin: 0 10px; }
    .field-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin: 10px 0; }
    .field-row label { display: flex; align-items: center; gap: 6px; font-size: 20px; }
    .field-row input[type='number'] { font-size: 24px; padding: 6px 10px; }
    .field-row input[type='text'] { font-size: 24px; padding: 6px 10px; }
    .match-scores { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 8px 0; }
    .match-score { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; text-align: center; }
    .match-score .ms-label { font-size: 13px; color: var(--muted); }
    .match-score .ms-value { font-size: 22px; font-variant-numeric: tabular-nums; font-weight: 700; }
    .match-round-title { font-size: 20px; font-weight: 800; margin: 10px 0; }
    .points-picker { margin: 10px 0; }
    /* 点数按键表：行=番，列=符 */
    .pt-table-wrap { overflow-x: auto; }
    .pt-table { border-collapse: collapse; margin: 10px 0; }
    .pt-table th, .pt-table td { border: 1px solid var(--line); padding: 3px 5px; text-align: center; white-space: nowrap; }
    .pt-table thead th { background: var(--accent-soft); font-weight: 700; font-size: 12px; }
    .pt-table .pt-row-label { background: var(--accent-soft); font-weight: 700; }
    .pt-btn { width: 100%; min-width: 80px; font-size: 13px; padding: 6px 8px; border-radius: 6px; border: 1px solid var(--line); background: var(--accent-soft); cursor: pointer; font-variant-numeric: tabular-nums; }
    .pt-btn:hover { background: var(--accent); color: #fff; }
    .pt-btn.sel { background: var(--accent); color: #fff; outline: 2px solid #ffd700; }
    .pt-tiers { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0; }
    .pt-tier { padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 16px; }
    .pt-tier.sel { background: var(--accent); color: #fff; border-color: var(--accent); }
    .match-actions { display: flex; gap: 10px; margin: 14px 0; flex-wrap: wrap; }
    .match-actions button { padding: 10px 22px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 18px; }
    .match-actions button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .match-actions button[disabled] { opacity: .45; cursor: not-allowed; }
    .sel-info { font-size: 15px; color: var(--muted); min-height: 20px; }
    .rounds-list { margin-top: 16px; }
    .rounds-list table { font-size: 15px; }
    .rounds-list button { font-size: 14px; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--card); cursor: pointer; }
    .rounds-list tr.settled { cursor: pointer; }
    .rounds-list tr.settled:hover { background: var(--accent-soft); }
    .draft-badge { color: #b45309; font-weight: 700; }
    @media (max-width: 720px) {
      .match-scores { grid-template-columns: repeat(2, 1fr); }
    }
  </style>
  <script>
    import { supabase } from '../../../lib/supabase'
    import { dealerSeat, nextRound, settleRound } from '../../../lib/scoring'
    import { replayGame, roundLabel, seatLabel, riichiText } from '../../../lib/replay'
    import type { RoundResult, RoundState } from '../../../lib/scoring'
    import type { StoredRound } from '../../../lib/replay'
    import pointsRaw from '../../../../data/points_table.json'
    import type { PointsTable } from '../../../lib/types'

    const points = pointsRaw as PointsTable
    const base = import.meta.env.BASE_URL
    const errEl = document.getElementById('match-err')!
    const root = document.getElementById('match-root')!
    const showErr = (m: string) => { errEl.textContent = m }
    const clearErr = () => { errEl.textContent = '' }

    // 80 符及以上较罕见，不设按键，遇见面手动输入
    const FU = ['20', '25', '30', '40', '50', '60', '70']
    const HAN = ['1', '2', '3', '4']
    const TIERS = points.tiers

    const params = new URLSearchParams(location.search)
    const gameId = params.get('id')
    if (!gameId) {
      root.innerHTML = '<p class="empty">缺少对局 id（?id=…）</p>'
    }

    let game: any = null
    let role: string | null = null
    let rounds: StoredRound[] = []
    let rep: ReturnType<typeof replayGame> | null = null
    let editingOrder: number | null = null
    /** 'edit'：修改本局并保留后续局自动重算；'rewind'：重录本局并删除后续局 */
    let editMode: 'edit' | 'rewind' | null = null
    /** 修改/回退时该局开始前的回退状态（局名本场=本局、供托/累计分=本局开始前） */
    let editState: { round: RoundState; pool: number; scores: number[] } | null = null
    let draftLoaded = false

    /** 编辑早局时取回退状态，否则取整场最新状态 */
    const stateOf = () => (editingOrder != null && editState ? editState : rep!.current)

    // 表单状态
    const form: {
      winType: 'ron' | 'tsumo' | 'draw' | null
      riichi: boolean[]
      winner: number | null
      loser: number | null
      ronPoints: number | null
      tsumoSplit: number[] | null
      tenpai: boolean[] | null
      selKey: string | null
    } = {
      winType: null,
      riichi: [false, false, false, false],
      winner: null,
      loser: null,
      ronPoints: null,
      tsumoSplit: null,
      tenpai: null,
      selKey: null,
    }

    function seatLabelOf(i: number): string { return seatLabel(i) }
    const view = (): 'child' | 'dealer' =>
      form.winner != null && rep && form.winner === dealerSeat(stateOf().round) ? 'dealer' : 'child'

    // ---------- 加载 ----------
    async function load() {
      if (!gameId) return
      const { data: { session } } = await supabase.auth.getSession()
      if (!session) { location.href = base + 'admin/login/'; return }
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single()
      role = profile?.role ?? null

      const { data: g, error } = await supabase.from('games').select('*').eq('id', gameId).single()
      if (error || !g) { showErr('加载对局失败：' + (error?.message ?? 'not found')); root.innerHTML = '<p class="empty">对局不存在。</p>'; return }
      game = g

      const { data: rs } = await supabase.from('rounds').select('*').eq('game_id', gameId).order('order', { ascending: true })
      rounds = (rs ?? []).map((r: any) => ({
        order: r.order,
        win_type: r.win_type,
        riichi: r.riichi ?? [false, false, false, false],
        ron_winner: r.ron_winner,
        ron_loser: r.ron_loser,
        ron_points: r.ron_points,
        tsumo_winner: r.tsumo_winner,
        tsumo_points: r.tsumo_points,
        tenpai: r.tenpai,
        override: r.override,
      }))
      rep = replayGame(rounds)

      if (game.status === 'finished' && role !== 'admin') {
        renderReadonly()
      } else {
        render()
      }
    }

    // ---------- 渲染 ----------
    function el(tag: string, cls = '', text = ''): HTMLElement {
      const n = document.createElement(tag)
      if (cls) n.className = cls
      if (text) n.textContent = text
      return n
    }

    function renderReadonly() {
      root.innerHTML = ''
      root.appendChild(el('p', '', '该半庄已完结，赛果如下（裁判不可修改，仅管理员可退回修改）。'))
      renderSummary(root)
    }

    function renderSummary(container: HTMLElement) {
      const seats = game.seats ?? []
      if (rep) {
        const scores = el('div', 'match-scores')
        seats.forEach((s: any, i: number) => {
          const box = el('div', 'match-score')
          const label = el('div', 'ms-label', `${s.seat} ${s.player ?? ''} ${s.rank ? s.rank + '位' : ''}`)
          const val = el('div', 'ms-value', String(s.points ?? rep!.current.scores[i]))
          box.append(label, val)
          scores.appendChild(box)
        })
        container.appendChild(scores)
      }
      renderRoundsList(container, true)
    }

    function render() {
      clearErr()
      if (!rep) return
      root.innerHTML = ''
      const seats = game.seats ?? []

      // 当前累计分（编辑早局时显示该局开始前的分数）
      const st = stateOf()
      const scores = el('div', 'match-scores')
      seats.forEach((s: any, i: number) => {
        const box = el('div', 'match-score')
        box.append(
          el('div', 'ms-label', s.seat + (s.player ? ' ' + s.player : '')),
          el('div', 'ms-value', String(st.scores[i])),
        )
        scores.appendChild(box)
      })
      root.appendChild(scores)

      // 局标题（编辑早局时显示被编辑局自己的局名本场/亲家/供托）
      const roundTitle = el('div', 'match-round-title')
      roundTitle.textContent = `${roundLabel(st.round)}　亲家：${seatLabelOf(dealerSeat(st.round))}　供托：${st.pool * 1000}点` +
        (editingOrder != null ? `　【修改第${editingOrder}局：${editMode === 'rewind' ? '回退重录（保存后删除后续局）' : '修改本局（保存后自动重算后续局）'}】` : '')
      root.appendChild(roundTitle)

      if (editingOrder == null && rep.current.draft && !draftLoaded) {
        loadDraftToForm(rep.current.draft)
        draftLoaded = true
      }

      if (game.status === 'finished' && role === 'admin') {
        const row = el('div', 'field-row')
        row.appendChild(el('span', '', '该半庄已完结，'))
        const backBtn = el('button', '', '退回修改（admin）')
        backBtn.addEventListener('click', async () => {
          const { error } = await supabase.rpc('unfinish_game', { p_game_id: gameId })
          if (error) return showErr('退回失败：' + error.message)
          clearErr()
          game.status = 'upcoming'
          render()
        })
        row.appendChild(backBtn)
        root.appendChild(row)
      }

      renderForm(root)
      renderRoundsList(root, false)
    }

    // ---------- 表单 ----------
    function renderForm(container: HTMLElement) {
      container.querySelector('.match-form')?.remove()
      const wrap = el('div', 'match-form')

      // 结果类型
      const typeRow = el('div', 'field-row')
      typeRow.appendChild(el('span', '', '结果：'))
      ;(['ron', 'tsumo', 'draw'] as const).forEach((t) => {
        const label = el('label')
        const radio = document.createElement('input')
        radio.type = 'radio'
        radio.name = 'winType'
        radio.value = t
        radio.checked = form.winType === t
        radio.addEventListener('change', () => { form.winType = t; renderForm(container) })
        const names: Record<string, string> = { ron: '荣和', tsumo: '自摸', draw: '荒牌流局' }
        label.append(radio, document.createTextNode(names[t]))
        typeRow.appendChild(label)
      })
      wrap.appendChild(typeRow)

      if (form.winType === 'ron') {
        wrap.appendChild(seatSelectRow('赢家', form.winner, (i) => { form.winner = i; renderForm(container) }))
        wrap.appendChild(seatSelectRow('放铳', form.loser, (i) => { form.loser = i; renderForm(container) }))
      } else if (form.winType === 'tsumo') {
        wrap.appendChild(seatSelectRow('自摸家', form.winner, (i) => { form.winner = i; renderForm(container) }))
      } else if (form.winType === 'draw') {
        const row = el('div', 'field-row')
        row.appendChild(el('span', '', '听牌：'))
        ;[0, 1, 2, 3].forEach((i) => {
          const label = el('label')
          const cb = document.createElement('input')
          cb.type = 'checkbox'
          cb.checked = form.tenpai?.[i] ?? false
          cb.addEventListener('change', () => {
            form.tenpai = form.tenpai ?? [false, false, false, false]
            form.tenpai[i] = cb.checked
            renderForm(container)
          })
          label.append(cb, document.createTextNode(seatLabelOf(i)))
          row.appendChild(label)
        })
        wrap.appendChild(row)
      }

      // 立直
      const riichiRow = el('div', 'field-row')
      riichiRow.appendChild(el('span', '', '立直：'))
      ;[0, 1, 2, 3].forEach((i) => {
        const label = el('label')
        const cb = document.createElement('input')
        cb.type = 'checkbox'
        cb.checked = form.riichi[i]
        cb.addEventListener('change', () => { form.riichi[i] = cb.checked })
        label.append(cb, document.createTextNode(seatLabelOf(i)))
        riichiRow.appendChild(label)
      })
      wrap.appendChild(riichiRow)

      if (form.winType === 'ron' || form.winType === 'tsumo') {
        renderPointsPicker(wrap)
      }

      // 操作按钮
      const actions = el('div', 'match-actions')
      const saveBtn = el('button', '', '保存草稿')
      saveBtn.addEventListener('click', saveDraft)
      const nextBtn = el('button', '', editingOrder != null ? '保存修改' : '下一局')
      nextBtn.addEventListener('click', saveAndNext)
      const viewBtn = el('button', 'primary', '查看结果')
      viewBtn.addEventListener('click', goResult)
      const importLabel = el('button', '', '导入直播 JSON')
      importLabel.addEventListener('click', importLiveJson)
      actions.append(saveBtn, nextBtn, viewBtn, importLabel)
      wrap.appendChild(actions)

      // 南四锁定：非连庄结果后半庄即终了，禁用「下一局」，由「查看结果」自动保存当前局并提交
      if (rep && form.winType && formComplete()) {
        const st = stateOf()
        const prospective = nextRound(st.round, buildResultFromForm()!)
        if (st.round.wind === '南' && st.round.number === 4 && !prospective) {
          const note = el('p', 'sel-info', '南四局：录完本局后点「查看结果」（会自动保存本局）提交，本局后半庄即终了。')
          note.style.color = '#b45309'
          wrap.appendChild(note)
          nextBtn.disabled = true
        } else if (st.round.wind === '南' && st.round.number === 4) {
          const note = el('p', 'sel-info', '南四局：亲家和牌/亲家听牌流局可继续「下一局」。')
          wrap.appendChild(note)
        }
      }

      const selInfo = el('p', 'sel-info', selectionText())
      wrap.appendChild(selInfo)

      // 表单始终保持在阶段表上方（勾选/选人会重渲染表单，避免被 append 挤到阶段表下面）
      const listEl = container.querySelector('.rounds-list')
      if (listEl) container.insertBefore(wrap, listEl)
      else container.appendChild(wrap)
    }

    function seatSelectRow(labelText: string, value: number | null, onPick: (i: number) => void): HTMLElement {
      const row = el('div', 'field-row')
      row.appendChild(el('span', '', labelText + '：'))
      ;[0, 1, 2, 3].forEach((i) => {
        const label = el('label')
        const radio = document.createElement('input')
        radio.type = 'radio'
        radio.name = labelText
        radio.checked = value === i
        radio.addEventListener('change', () => onPick(i))
        const seat = game.seats?.[i]
        label.append(radio, document.createTextNode(`${seatLabelOf(i)}${seat?.player ? ' ' + seat.player : ''}`))
        row.appendChild(label)
      })
      return row
    }

    // ---------- 点数选择（按键式，按番分组） ----------
    function renderPointsPicker(container: HTMLElement) {
      const v = view()
      const isRon = form.winType === 'ron'
      const box = el('div', 'points-picker')

      // 1-4 番 × 符 按键表（满贯格不设按键；荣和不存在 20 符，故荣和视图 20 符列为空）
      const wrap = el('div', 'pt-table-wrap')
      const table = el('table', 'pt-table')
      const thead = el('thead')
      const htr = el('tr')
      htr.appendChild(el('th', '', ''))
      FU.forEach((f) => htr.appendChild(el('th', '', `${f}符`)))
      thead.appendChild(htr)
      table.appendChild(thead)
      const tbody = el('tbody')
      HAN.forEach((h) => {
        const tr = el('tr')
        tr.appendChild(el('th', 'pt-row-label', `${h}番`))
        FU.forEach((f) => {
          const td = el('td')
          if (!(isRon && f === '20')) {
            const cell = points.grid[v][h]?.[f]
            if (cell) {
              const btn = document.createElement('button')
              btn.type = 'button'
              btn.className = 'pt-btn'
              btn.textContent = isRon ? String(cell.ron) : cell.tsumo.join('/')
              btn.title = `${h}番${f}符`
              const key = `cell:${v}:${h}:${f}`
              if (form.selKey === key) btn.classList.add('sel')
              btn.addEventListener('click', () => {
                form.selKey = key
                if (isRon) { form.ronPoints = cell.ron; form.tsumoSplit = null }
                else { form.tsumoSplit = [...cell.tsumo]; form.ronPoints = null }
                render()
              })
              td.appendChild(btn)
            }
          }
          tr.appendChild(td)
        })
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      wrap.appendChild(table)
      box.appendChild(wrap)

      // 高番档
      const tiers = el('div', 'pt-tiers')
      TIERS.forEach((t) => {
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'pt-tier'
        const val = v === 'dealer' ? (isRon ? t.dealerRon : t.dealerTsumo[0]) : (isRon ? t.childRon : `${t.childTsumo[0]}/${t.childTsumo[1]}`)
        btn.textContent = `${t.label} ${val}`
        const key = `tier:${t.key}`
        if (form.selKey === key) btn.classList.add('sel')
        btn.addEventListener('click', () => {
          form.selKey = key
          if (isRon) {
            form.ronPoints = v === 'dealer' ? t.dealerRon : t.childRon
            form.tsumoSplit = null
          } else {
            form.tsumoSplit = v === 'dealer' ? [...t.dealerTsumo] : [...t.childTsumo]
            form.ronPoints = null
          }
          render()
        })
        tiers.appendChild(btn)
      })
      box.appendChild(tiers)

      // 手动输入兜底
      const manual = el('div', 'field-row')
      manual.appendChild(el('span', '', '手动：'))
      if (isRon) {
        const input = document.createElement('input')
        input.type = 'number'
        input.placeholder = '基础点数'
        input.style.width = '110px'
        input.value = form.ronPoints != null ? String(form.ronPoints) : ''
        input.addEventListener('change', () => {
          form.ronPoints = Number(input.value) || null
          form.tsumoSplit = null
          form.selKey = null
          render()
        })
        manual.appendChild(input)
      } else {
        const parts = v === 'dealer' ? 1 : 2
        const inputs: HTMLInputElement[] = []
        for (let k = 0; k < parts; k++) {
          const input = document.createElement('input')
          input.type = 'number'
          input.placeholder = v === 'dealer' ? '各付' : k === 0 ? '子付' : '亲付'
          input.style.width = '90px'
          if (form.tsumoSplit?.[k] != null) input.value = String(form.tsumoSplit[k])
          inputs.push(input)
          manual.appendChild(input)
        }
        manual.appendChild(el('span', '', '点'))
        const apply = el('button', '', '确认')
        apply.addEventListener('click', () => {
          const vals = inputs.map((i) => Number(i.value))
          if (vals.some((x) => !x || x <= 0 || x % 100 !== 0)) { showErr('手动点数须为正的 100 倍数'); return }
          form.tsumoSplit = vals
          form.ronPoints = null
          form.selKey = null
          clearErr()
          render()
        })
        manual.appendChild(apply)
      }
      box.appendChild(manual)

      container.appendChild(box)
    }

    function selectionText(): string {
      if (form.winType === 'ron') return form.ronPoints ? `荣和 ${form.ronPoints} 点` : '未选择点数'
      if (form.winType === 'tsumo') return form.tsumoSplit ? `自摸 ${form.tsumoSplit.join('/')} 点` : '未选择点数'
      if (form.winType === 'draw') {
        const n = (form.tenpai ?? []).filter(Boolean).length
        return `荒牌流局，听牌 ${n} 家`
      }
      return ''
    }

    // ---------- 结果构建 / 校验 ----------
    function buildResultFromForm(): RoundResult | null {
      const riichi = [...form.riichi]
      if (form.winType === 'ron') {
        if (form.winner == null || form.loser == null || !form.ronPoints) return null
        return { winType: 'ron', riichi, winner: form.winner, loser: form.loser, ronPoints: form.ronPoints }
      }
      if (form.winType === 'tsumo') {
        if (form.winner == null || !form.tsumoSplit) return null
        const pays = [0, 0, 0, 0]
        if (form.tsumoSplit.length === 1) {
          for (let i = 0; i < 4; i++) if (i !== form.winner) pays[i] = form.tsumoSplit[0]
        } else {
          const d = dealerSeat(stateOf().round)
          for (let i = 0; i < 4; i++) {
            if (i === form.winner) continue
            pays[i] = i === d ? form.tsumoSplit[1] : form.tsumoSplit[0]
          }
        }
        return { winType: 'tsumo', riichi, winner: form.winner, tsumoPayments: pays }
      }
      if (form.winType === 'draw') {
        // 四家都不听牌（不勾任何听牌）也是合法流局，缺省按全不听牌处理
        return { winType: 'draw', riichi, tenpai: form.tenpai ?? [false, false, false, false] }
      }
      return null
    }

    function formComplete(): boolean {
      if (!form.winType) return false
      const r = buildResultFromForm()
      if (!r) return false
      if (r.winType === 'ron' && r.winner === r.loser) return false
      return true
    }

    // ---------- 保存 ----------
    async function saveDraft() {
      if (!gameId || !rep) return
      clearErr()
      const order = editingOrder ?? rep.current.settled + 1
      const payload = {
        game_id: gameId,
        order,
        win_type: form.winType,
        riichi: form.riichi,
        ron_winner: form.winType === 'ron' && form.winner != null ? seatLabelOf(form.winner) : null,
        ron_loser: form.winType === 'ron' && form.loser != null ? seatLabelOf(form.loser) : null,
        ron_points: form.winType === 'ron' ? form.ronPoints : null,
        tsumo_winner: form.winType === 'tsumo' && form.winner != null ? seatLabelOf(form.winner) : null,
        tsumo_points: form.winType === 'tsumo' ? form.tsumoSplit : null,
        tenpai: form.winType === 'draw' ? form.tenpai : null,
      }
      const { error } = await supabase.from('rounds').upsert(payload, { onConflict: 'game_id,order' })
      if (error) return showErr('保存草稿失败：' + error.message)
      showErr('草稿已保存。')
    }

    async function saveAndNext() {
      if (!gameId || !rep) return
      clearErr()
      if (!formComplete()) { showErr('请补全本小局：结果、赢家/放铳（或自摸家）、点数（或听牌）'); return }
      if (form.winType === 'ron' && form.winner === form.loser) { showErr('荣和赢家与放铳不能是同一家'); return }
      const result = buildResultFromForm()!
      // 平衡校验（编辑早局时用该局开始前的回退状态）
      const st = stateOf()
      const s = settleRound(st.round, result, st.pool)
      if (s.deltas.reduce((a, b) => a + b, 0) + (s.poolAfter - st.pool) * 1000 !== 0) {
        showErr('点数不平衡，请检查录入')
        return
      }
      const order = editingOrder ?? rep.current.settled + 1
      const payload = {
        game_id: gameId,
        order,
        win_type: form.winType,
        riichi: form.riichi,
        ron_winner: form.winType === 'ron' ? seatLabelOf(form.winner!) : null,
        ron_loser: form.winType === 'ron' ? seatLabelOf(form.loser!) : null,
        ron_points: form.winType === 'ron' ? form.ronPoints : null,
        tsumo_winner: form.winType === 'tsumo' ? seatLabelOf(form.winner!) : null,
        tsumo_points: form.winType === 'tsumo' ? form.tsumoSplit : null,
        tenpai: form.winType === 'draw' ? (form.tenpai ?? [false, false, false, false]) : null,
        override: null, // 重新按输入自动生成时清除手动覆盖
      }
      const { error } = await supabase.from('rounds').upsert(payload, { onConflict: 'game_id,order' })
      if (error) return showErr('保存失败：' + error.message)
      // 「回退」删除其后小局；「修改」保留后续局，整场重放自动更正
      const savedOrder = editingOrder
      const savedMode = editMode
      if (editingOrder != null && editMode === 'rewind') {
        // order 为 Postgres 保留字，过滤列需加双引号，否则被 PostgREST 当作排序参数而 400
        const del = await supabase.from('rounds').delete().eq('game_id', gameId).gt('"order"', editingOrder)
        if (del.error) {
          editingOrder = null
          editMode = null
          editState = null
          resetForm()
          await refreshRounds()
          render()
          showErr('回退失败（后续局未删除）：' + del.error.message)
          return
        }
      }
      editingOrder = null
      editMode = null
      editState = null
      // 南四锁定：下一局为 null 时不允许继续
      if (nextRound(st.round, result) === null && savedOrder == null) {
        showErr('南四局已结束（非连庄结果），请「查看结果」并提交。')
        resetForm()
        await refreshRounds()
        render()
        return
      }
      resetForm()
      await refreshRounds()
      render()
      // 「修改」模式：检测后续局可能受影响的情况
      if (savedMode === 'edit' && savedOrder != null) {
        checkEditWarnings(savedOrder)
      }
    }

    /** 「修改」保存后的边界检测：孤儿局 / 手动覆盖冻结 / 自摸支付格式与亲家不符 */
    function checkEditWarnings(editedOrder: number) {
      if (!rep) return
      const warns: string[] = []
      const settledOrders = new Set(rep.history.map((h) => h.order))
      const orphans = rounds.filter((r) => r.win_type && !settledOrders.has(r.order))
      if (orphans.length > 0) {
        warns.push(`第${orphans.map((r) => r.order).join('、')}局已超出修改后的半庄范围（仍保留在库中但未计入赛果；如需删除请用「回退」重录该局）`)
      }
      const frozen = rounds.filter((r) => r.order > editedOrder && r.override != null)
      if (frozen.length > 0) {
        warns.push(`第${frozen.map((r) => r.order).join('、')}局为手动修改状态，其四家增减保持不变（如需跟随自动重算请清除该局手动）`)
      }
      for (const h of rep.history) {
        if (h.result.winType !== 'tsumo') continue
        const stored = rounds.find((r) => r.order === h.order)
        const split = stored?.tsumo_points
        if (!split) continue
        const isDealerFormat = split.length === 1
        const winnerIsDealer = h.result.winner === dealerSeat(h.round)
        if (isDealerFormat !== winnerIsDealer) {
          warns.push(`第${h.order}局自摸支付格式与当前亲家不符，请核对`)
        }
      }
      if (warns.length > 0) showErr(warns.join('；'))
    }

    function resetForm() {
      form.winType = null
      form.riichi = [false, false, false, false]
      form.winner = null
      form.loser = null
      form.ronPoints = null
      form.tsumoSplit = null
      form.tenpai = null
      form.selKey = null
      draftLoaded = false
    }

    async function fetchRounds(): Promise<StoredRound[]> {
      const { data } = await supabase.from('rounds').select('*').eq('game_id', gameId).order('order', { ascending: true })
      return (data ?? []).map((r: any) => ({
        order: r.order,
        win_type: r.win_type,
        riichi: r.riichi ?? [false, false, false, false],
        ron_winner: r.ron_winner,
        ron_loser: r.ron_loser,
        ron_points: r.ron_points,
        tsumo_winner: r.tsumo_winner,
        tsumo_points: r.tsumo_points,
        tenpai: r.tenpai,
        override: r.override,
      }))
    }

    async function refreshRounds() {
      rounds = await fetchRounds()
      rep = replayGame(rounds)
    }

    function loadDraftToForm(d: StoredRound) {
      form.winType = d.win_type
      form.riichi = [...(d.riichi ?? [false, false, false, false])]
      if (d.win_type === 'ron') {
        form.winner = seatIndexOfSafe(d.ron_winner)
        form.loser = seatIndexOfSafe(d.ron_loser)
        form.ronPoints = d.ron_points
      } else if (d.win_type === 'tsumo') {
        form.winner = seatIndexOfSafe(d.tsumo_winner)
        form.tsumoSplit = d.tsumo_points ? [...d.tsumo_points] : null
      } else if (d.win_type === 'draw') {
        form.tenpai = d.tenpai ? [...d.tenpai] : null
      }
    }

    function seatIndexOfSafe(s: string | null): number | null {
      if (s == null) return null
      const i = ['东', '南', '西', '北'].indexOf(s)
      return i >= 0 ? i : null
    }

    // ---------- 已录小局列表 + 修改/回退 ----------
    function renderRoundsList(container: HTMLElement, readonly: boolean) {
      if (!rep) return
      const box = el('div', 'rounds-list')
      box.appendChild(el('h3', '', '阶段表' + (readonly ? '' : '（点「改」修改本局并自动重算后续；点「回退」重录本局并删除后续）')))
      const table = el('table')
      const thead = el('thead')
      const htr = el('tr')
      ;['序', '局', '立直家', '结果', '打点', '供托', '增减', '操作'].forEach((h) => htr.appendChild(el('th', '', h)))
      thead.appendChild(htr)
      table.appendChild(thead)
      const tbody = el('tbody')
      rep.history.forEach((h) => {
        const tr = el('tr', 'settled')
        tr.appendChild(el('td', '', String(h.order)))
        tr.appendChild(el('td', '', h.override?.roundLabel ?? roundLabel(h.round)))
        tr.appendChild(el('td', '', riichiText(h.result.riichi)))
        tr.appendChild(el('td', '', h.override?.result ?? resultText(h.result)))
        tr.appendChild(el('td', 'num', h.override?.points != null ? String(h.override.points) : pointsText(h.result)))
        tr.appendChild(el('td', 'num', String(h.pool * 1000)))
        const deltasTd = el('td', 'num', h.deltas.join('/'))
        if (h.override?.deltas) deltasTd.classList.add('draft-badge')
        tr.appendChild(deltasTd)
        if (!readonly) {
          const opsTd = el('td')
          const editBtn = el('button', '', '改')
          editBtn.title = '修改本局，保存后自动重算后续小局'
          editBtn.addEventListener('click', () => openEdit(h.order, 'edit'))
          const rewindBtn = el('button', '', '回退')
          rewindBtn.title = '重录本局，保存后删除后续小局'
          rewindBtn.style.marginLeft = '6px'
          rewindBtn.addEventListener('click', () => openEdit(h.order, 'rewind'))
          opsTd.append(editBtn, rewindBtn)
          tr.appendChild(opsTd)
        }
        tbody.appendChild(tr)
      })
      if (rep.current.draft) {
        const tr = el('tr')
        tr.appendChild(el('td', '', String(rep.current.draft.order)))
        tr.appendChild(el('td', 'draft-badge', roundLabel(rep.current.round) + '（草稿）'))
        tr.appendChild(el('td', '', ''))
        tr.appendChild(el('td', 'draft-badge', '未完成'))
        tr.appendChild(el('td', '', ''))
        tr.appendChild(el('td', '', ''))
        tr.appendChild(el('td', '', ''))
        tr.appendChild(el('td', '', ''))
        tbody.appendChild(tr)
      }
      table.appendChild(tbody)
      box.appendChild(table)
      container.appendChild(box)
    }

    function resultText(r: RoundResult): string {
      if (r.winType === 'ron') return `${seatLabelOf(r.winner!)}荣和${seatLabelOf(r.loser!)}`
      if (r.winType === 'tsumo') return `${seatLabelOf(r.winner!)}自摸`
      if (r.winType === 'draw') {
        const n = (r.tenpai ?? []).filter(Boolean).length
        return n === 0 ? '流局(无人听)' : `流局(听牌${n})`
      }
      return '?'
    }

    function pointsText(r: RoundResult): string {
      if (r.winType === 'ron') return String(r.ronPoints)
      if (r.winType === 'tsumo') {
        const pays = r.tsumoPayments!.filter((x) => x > 0)
        return pays.join('/')
      }
      return ''
    }

    function pointsNum(r: RoundResult): number | null {
      if (r.winType === 'ron') return r.ronPoints ?? null
      if (r.winType === 'tsumo') {
        const pays = r.tsumoPayments!.filter((x) => x > 0)
        return pays.reduce((a, b) => a + b, 0) || null
      }
      return null
    }

    /**
     * 打开第 order 局的录入表单（重新选择该局录入字段）。
     * mode='edit'：保存后保留后续局，整场重放自动更正；
     * mode='rewind'：保存后删除该局之后的全部小局。
     * 同时计算该局开始前的回退状态，供顶部显示/点数表/校验使用。
     */
    function openEdit(order: number, mode: 'edit' | 'rewind') {
      const stored = rounds.find((r) => r.order === order)
      if (!stored || !stored.win_type) return
      editingOrder = order
      editMode = mode
      // 回退状态：局名本场 = 本局自身；供托/累计分 = 本局开始前（即上一局结算后）
      const hist = rep?.history ?? []
      const idx = hist.findIndex((x) => x.order === order)
      const prev = idx > 0 ? hist[idx - 1] : null
      editState = {
        round: idx >= 0 ? hist[idx].round : { wind: '东', number: 1, honba: 0 },
        pool: prev ? prev.pool : 0,
        scores: prev ? [...prev.scores] : [25000, 25000, 25000, 25000],
      }
      form.winType = stored.win_type
      form.riichi = [...stored.riichi]
      if (stored.win_type === 'ron') {
        form.winner = seatIndexOfSafe(stored.ron_winner)
        form.loser = seatIndexOfSafe(stored.ron_loser)
        form.ronPoints = stored.ron_points
        form.tsumoSplit = null
      } else if (stored.win_type === 'tsumo') {
        form.winner = seatIndexOfSafe(stored.tsumo_winner)
        form.tsumoSplit = stored.tsumo_points ? [...stored.tsumo_points] : null
        form.ronPoints = null
      } else {
        form.tenpai = stored.tenpai ? [...stored.tenpai] : null
      }
      form.selKey = null
      render()
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }

    // ---------- 查看结果 ----------
    async function goResult() {
      if (!gameId) return
      // 先保存当前已完成的小局，避免南四局等最后一局因直接跳转而丢失
      if (rep && formComplete()) {
        await saveDraft()
      }
      location.href = base + 'admin/match/result/?id=' + encodeURIComponent(gameId)
    }

    async function importLiveJson() {
      if (!gameId) return
      const input = document.createElement('input')
      input.type = 'file'
      input.accept = 'application/json,.json'
      input.addEventListener('change', async () => {
        const file = input.files?.[0]
        if (!file) return
        clearErr()
        let payload: any
        try {
          payload = JSON.parse(await file.text())
        } catch {
          showErr('JSON 解析失败，请检查文件格式')
          return
        }
        const importedRounds = normalizeLiveRounds(payload)
        if (importedRounds.length === 0) {
          showErr('未找到可导入的小局数据')
          return
        }
        const ok = window.confirm(`将覆盖本半庄当前 ${rounds.length} 条逐局记录，并导入 ${importedRounds.length} 条直播记录。直播用宝牌/听牌牌图不会进入正式赛果。是否继续？`)
        if (!ok) return
        const del = await supabase.from('rounds').delete().eq('game_id', gameId).gt('"order"', 0)
        if (del.error) {
          showErr('清空原逐局记录失败：' + del.error.message)
          return
        }
        for (const round of importedRounds) {
          const { error } = await supabase.from('rounds').upsert({ ...round, game_id: gameId }, { onConflict: 'game_id,order' })
          if (error) {
            showErr(`导入第 ${round.order} 局失败：` + error.message)
            return
          }
        }
        resetForm()
        editingOrder = null
        editMode = null
        editState = null
        draftLoaded = false
        await refreshRounds()
        render()
        showErr('直播 JSON 已导入；已忽略 liveOnly 中的宝牌、听牌牌图和紧急改分。')
      })
      input.click()
    }

    function normalizeLiveRounds(payload: any): StoredRound[] {
      const rows = Array.isArray(payload?.rounds) ? payload.rounds : []
      return rows
        .map((r: any, i: number) => ({
          order: Number.isInteger(Number(r.order)) ? Number(r.order) : i + 1,
          win_type: r.win_type === 'ron' || r.win_type === 'tsumo' || r.win_type === 'draw' ? r.win_type : null,
          riichi: normalizeBoolArray(r.riichi),
          ron_winner: r.win_type === 'ron' ? normalizeSeat(r.ron_winner) : null,
          ron_loser: r.win_type === 'ron' ? normalizeSeat(r.ron_loser) : null,
          ron_points: r.win_type === 'ron' && Number.isFinite(Number(r.ron_points)) ? Number(r.ron_points) : null,
          tsumo_winner: r.win_type === 'tsumo' ? normalizeSeat(r.tsumo_winner) : null,
          tsumo_points: r.win_type === 'tsumo' && Array.isArray(r.tsumo_points) ? r.tsumo_points.map((x: any) => Number(x)).filter((x: number) => Number.isFinite(x)) : null,
          tenpai: r.win_type === 'draw' ? normalizeBoolArray(r.tenpai) : null,
          override: null,
        }))
        .filter((r: StoredRound) => r.win_type != null)
        .sort((a: StoredRound, b: StoredRound) => a.order - b.order)
        .map((r: StoredRound, i: number) => ({ ...r, order: i + 1 }))
    }

    function normalizeBoolArray(value: any): boolean[] {
      const arr = Array.isArray(value) ? value : []
      return [0, 1, 2, 3].map((i) => Boolean(arr[i]))
    }

    function normalizeSeat(value: any): string | null {
      return ['东', '南', '西', '北'].includes(value) ? value : null
    }

    load()
  </script>
</BaseLayout>
