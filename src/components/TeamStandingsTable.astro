---
import { formatPt } from '../lib/standings'
import { teamText } from '../lib/data'
import type { ComputedTeamRow } from '../lib/standings'
import type { TeamInfo, Wins } from '../lib/types'

interface Props {
  stage: string
  rows: ComputedTeamRow[]
  teams: TeamInfo[]
  totalGames: number
}

const { stage, rows, teams, totalGames } = Astro.props
const colorOf = (name: string) => teams.find((t) => t.name === name)?.color ?? '#9ca3af'
const ts = (name: string) => `background:${colorOf(name)};color:${teamText(name)}`
const fmtName = (n: string) => /^[一-鿿]{2}$/.test(n) ? n[0] + ' ' + n[1] : n
const fmt = (n: number | null) => formatPt(n)
const sum = (w: Wins) => w['1'] + w['2'] + w['3'] + w['4']

const promoteRank = stage === '常规赛' ? 6 : stage === '半决赛' ? 4 : 0

function rankClass(rank: number): string {
  const c = ['rank', 'col-rank-t']
  if (stage === '常规赛') {
    if (rank <= 4) c.push('rank-safe')
    else if (rank <= 6) c.push('rank-bubble')
    else c.push('rank-out')
  } else if (stage === '半决赛') {
    if (rank <= 4) c.push('rank-safe')
    else c.push('rank-out')
  } else if (stage === '决赛') {
    if (rank === 1) c.push('rank-bubble')
  }
  return c.join(' ')
}

const HEADERS: Record<string, string[]> = {
  常规赛: ['顺位', '队伍', '积分', '素点', '差', '晋级线差', '场次', '1位', '2位', '3位', '4位'],
  半决赛: ['顺位', '队伍', '积分', '半决赛积分', '持越', '差', '晋级线差', '场次', '1位', '2位', '3位', '4位'],
  决赛: ['顺位', '队伍', '积分', '决赛积分', '持越', '差', '一位差', '场次', '1位', '2位', '3位', '4位'],
}
const header = HEADERS[stage] ?? HEADERS['常规赛']
---
<div class:list={['table-wrap', 'team-table', `stage-${stage}`]}>
  <table>
    <thead>
      <tr>
        {header.map((h, i) => <th class:list={{ 'col-w': i >= header.length - 4, 'col-diff': h === '差' || h === '晋级线差' || h === '一位差' }}>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => {
          const neg = r.points < 0 ? ' neg' : ''
          const isSep = promoteRank > 0 && r.rank === promoteRank + 1
          return (
            <tr class:list={{ 'sep': isSep }}>
              <td class={rankClass(r.rank)}>{r.rank}</td>
              <td class="team-col" style={ts(r.team)}>
                {/^[一-鿿]{2}$/.test(r.team) ? <>{r.team[0]}<span class="team-sep"> </span>{r.team[1]}</> : r.team}
              </td>
              <td class="num col-pts">
                <span class={`pts-val${neg}`}>{formatPt(r.points)}</span>
                <span class="pts-label">pts</span>
              </td>
              {stage !== '常规赛' && <td class="num">{formatPt(r.stagePoints)}</td>}
              {stage !== '常规赛' && <td class="num">{formatPt(r.carry)}</td>}
              {stage === '常规赛' && <td class="num raw">{formatPt(r.stageRaw)}</td>}
              <td class="num col-diff">{fmt(r.diff)}</td>
              {stage === '决赛'
                ? <td class="num col-diff">{fmt(r.firstDiff)}</td>
                : <td class="num col-diff">{fmt(r.advDiff)}</td>}
              <td class="num col-games">
                <span class="games-num">{sum(r.wins)}</span>
                <span class="games-total">/{totalGames}</span>
              </td>
              <td class="num col-w">{r.wins['1']}</td>
              <td class="num col-w">{r.wins['2']}</td>
              <td class="num col-w">{r.wins['3']}</td>
              <td class="num col-w">{r.wins['4']}</td>
            </tr>
          )
        })
      }
    </tbody>
  </table>
</div>
