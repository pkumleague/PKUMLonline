---
import { formatPct, formatPt, formatScore } from '../lib/standings'
import { teamText } from '../lib/data'
import type { ComputedPlayerRow } from '../lib/standings'
import type { TeamInfo } from '../lib/types'

interface Props {
  rows: ComputedPlayerRow[]
  teams: TeamInfo[]
}

const { rows, teams } = Astro.props
const colorOf = (name: string) => teams.find((t) => t.name === name)?.color ?? '#9ca3af'
const ts = (name: string) => `background:${colorOf(name)};color:${teamText(name)}`

const num = (n: number | null) => (n == null || n === 0 ? '' : formatPt(n))
const win = (n: number) => (n === 0 ? '' : String(n))
const pct = (n: number | null) => (n == null || n === 0 ? '' : formatPct(n))
const base = import.meta.env.BASE_URL
---
<div class="table-wrap player-table">
  <table>
    <thead>
      <tr>
        <th>顺位</th><th>所属</th><th>选手名</th><th>积分</th><th>素点</th><th>判罚</th>
        <th>场次</th><th class="col-avg"><span class="avg-full">平均顺位</span><span class="avg-short">平顺</span></th><th class="col-w">1位</th><th class="col-w">2位</th><th class="col-w">3位</th><th class="col-w">4位</th>
        <th>一位率</th><th>连对率</th><th>避四率</th><th>最高分</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr data-href={`${base}archive#player-${encodeURIComponent(r.name)}`}>
            <td class="rank col-rank-p">{r.rank}</td>
            <td class="team-col" style={ts(r.team)}>{r.team}</td>
            <td>{r.name}</td>
            <td class="num col-pts-p">{r.points < 0 ? <span class="neg">{formatPt(r.points)}</span> : num(r.points)}</td>
            <td class="num raw">{num(r.rawPoints)}</td>
            <td class="num">{r.penalty ? <span class="penalty">{formatPt(r.penalty)}</span> : ''}</td>
            <td class="num">{win(r.games)}</td>
            <td class="num col-avg">{r.avgRank == null ? '' : r.avgRank.toFixed(2)}</td>
            <td class="num col-w">{win(r.wins['1'])}</td>
            <td class="num col-w">{win(r.wins['2'])}</td>
            <td class="num col-w">{win(r.wins['3'])}</td>
            <td class="num col-w">{win(r.wins['4'])}</td>
            <td class="num">{pct(r.winRate)}</td>
            <td class="num">{pct(r.pairRate)}</td>
            <td class="num">{pct(r.avoidRate)}</td>
            <td class="num">{r.maxScore ? formatScore(r.maxScore) : ''}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<script>
  document.querySelectorAll('tr[data-href]').forEach((row) => {
    row.addEventListener('click', () => {
      window.location.href = row.dataset.href
    })
  })
</script>
