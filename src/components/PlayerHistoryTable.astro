---
import { formatPt, formatScore, formatPct } from '../lib/standings'
import { teamText } from '../lib/data'
import type { PlayerRecord, TeamInfo } from '../lib/types'

interface Props {
  player: PlayerRecord
  teams: TeamInfo[]
  /** 该选手 26-27 赛季所属队伍（现役）；null = 未入选，不显示最新赛季行 */
  curTeam?: string | null
}

const { player, teams, curTeam = null } = Astro.props
const colorOf = (name: string) => teams.find((t) => t.name === name)?.color ?? '#9ca3af'
const ts = (name: string) => `background:${colorOf(name)};color:${teamText(name)}`
const fmtPct = (n: number | null) => (n == null ? '-' : `${n.toFixed(2)}%`)
---
<div class="table-wrap history-table">
  <table>
    <colgroup>
      <col style="width:55px">
      <col style="width:70px">
      <col style="width:80px">
      <col style="width:80px">
      <col style="width:80px">
      <col style="width:90px">
      <col style="width:80px">
      <col style="width:70px">
    </colgroup>
    <thead>
      <tr>
        <th>赛季</th><th>隶属队伍</th><th>常规赛积分</th><th>半决赛积分</th><th>决赛积分</th>
        <th>常规赛最高分</th><th>常规赛避四率</th><th>队伍名次</th>
      </tr>
    </thead>
    <tbody>
      {
        curTeam && (
          <tr class="cur-season" data-cur={player.name} data-team={curTeam}>
            <td class="num">26-27</td>
            <td class="team-col" style={ts(curTeam)}>{curTeam}</td>
            <td class="num" data-cur-pts>-</td>
            <td class="num" data-cur-semi>-</td>
            <td class="num" data-cur-fin>-</td>
            <td class="num" data-cur-max>-</td>
            <td class="num" data-cur-avoid>-</td>
            <td class="num" data-cur-rank>-</td>
          </tr>
        )
      }
      {
        player.history.length > 0 && (
          [...player.history].reverse().map((h) => (
            <tr>
              <td class="num">{h.year}</td>
              <td class="team-col" style={h.team ? ts(h.team) : ''}>{h.team ?? '-'}</td>
              <td class="num">{formatPt(h.regularPoints)}</td>
              <td class="num">{formatPt(h.semifinalPoints)}</td>
              <td class="num">{formatPt(h.finalPoints)}</td>
              <td class="num">{formatScore(h.regularMaxScore)}</td>
              <td class="num">{fmtPct(h.regularAvoidRate)}</td>
              <td class="num">{h.teamRank ?? '-'}</td>
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</div>
